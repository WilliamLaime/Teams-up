#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  # puts "\n== Copying sample files =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  # ── Graphe de code graphify (optionnel) ─────────────────────────────────────
  # Le graphe lui-même est versionné : il est déjà là après un `git pull`, même
  # sans graphify installé. Cette étape ne configure que ce qui NE PEUT PAS être
  # versionné par git — les hooks et le pilote de fusion — et n'installe jamais
  # rien sur la machine sans que la personne l'ait décidé.
  puts "\n== Graphe de code (optionnel) =="
  if system("command -v graphify > /dev/null 2>&1")
    # git ignore .git/hooks/ : sans core.hooksPath, le hook partagé de
    # .githooks/ ne serait jamais exécuté chez qui que ce soit.
    system! "git config core.hooksPath .githooks"

    # Le graphe n'est plus versionné : il faut le construire une première fois
    # sur ce poste. Ensuite le hook pre-commit le maintient à jour.
    system "graphify update ."

    puts "  hook configuré, graphe construit localement."
    puts "  il se met à jour tout seul à chaque commit."
  else
    puts "  graphify n'est pas installé — étape ignorée, le projet fonctionne normalement."
    puts "  Les commandes `graphify explain \"MaClasse\"` et `graphify affected \"MaClasse\"`"
    puts "  deviennent disponibles après :"
    puts ""
    puts "      pipx install graphifyy   # ou : brew install pipx && pipx install graphifyy"
    puts "      bin/setup                # relancer pour activer les hooks"
  end

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
