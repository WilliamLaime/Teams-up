<%# Article de blog individuel %>
<%# SEO : title, meta description et og:image personnalisés par article %>

<%# meta-tags gem + Schema.org JSON-LD pour Google %>
<% description = @article.meta_description.presence || truncate(@article.body, length: 155) %>
<% set_meta_tags title: @article.title,
                 description: description,
                 og: {
                   title: @article.title,
                   description: description,
                   type: "article",
                   url: article_url(@article.slug),
                   image: @article.cover_image_url.presence
                 } %>

<%# Schema.org Article + BreadcrumbList : données structurées lues par Google pour les rich snippets %>
<% content_for :head do %>
  <%# Schema Article — author requis pour le signal E-E-A-T (expertise identifiable) %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "<%= j @article.title %>",
    "description": "<%= j description %>",
    "datePublished": "<%= @article.published_at.iso8601 %>",
    "dateModified": "<%= @article.updated_at.iso8601 %>",
    "author": { "@type": "Organization", "name": "Teams-up", "url": "<%= root_url %>" },
    "publisher": {
      "@type": "Organization",
      "name": "Teams-up",
      "url": "<%= root_url %>",
      "logo": { "@type": "ImageObject", "url": "<%= asset_url('logo/logo_vf_1_noir.png') %>" }
    },
    "url": "<%= article_url(@article.slug) %>"
    <%= ", \"image\": \"#{j @article.cover_image_url}\"" if @article.cover_image_url.present? %>
  }
  </script>
  <%# BreadcrumbList — affiche le fil d'Ariane directement dans les résultats Google %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "<%= root_url %>" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "<%= articles_url %>" },
      { "@type": "ListItem", "position": 3, "name": "<%= j @article.title %>" }
    ]
  }
  </script>
<% end %>

<div class="blog-show">
  <div class="container">
    <div class="blog-show__wrapper">

      <%# Fil d'Ariane : aide la navigation et le SEO %>
      <nav class="blog-show__breadcrumb" aria-label="Fil d'Ariane">
        <%= link_to "Accueil", root_path %> /
        <%= link_to "Blog", articles_path %> /
        <span><%= truncate(@article.title, length: 40) %></span>
      </nav>

      <%# En-tête article %>
      <header class="blog-show__header">
        <%# Catégorie + temps de lecture %>
        <div class="blog-show__meta">
          <% if @article.category.present? %>
            <%= link_to @article.category.capitalize, articles_path(category: @article.category),
                  class: "blog-show__category" %>
          <% end %>
          <span class="blog-show__reading-time">
            <i data-lucide="clock" style="width:13px; height:13px;"></i>
            <%= @article.reading_time_minutes %> min de lecture
          </span>
        </div>

        <h1 class="blog-show__title"><%= @article.title %></h1>

        <p class="blog-show__date">
          Publié le <%= I18n.l(@article.published_at.to_date, format: :long) %>
        </p>
      </header>

      <%# Image de couverture %>
      <% if @article.cover_image_url.present? %>
        <div class="blog-show__cover">
          <img src="<%= @article.cover_image_url %>"
               alt="<%= @article.title %>"
               style="width:100%; border-radius:12px; object-fit:cover; max-height:420px;">
        </div>
      <% end %>

      <%# Corps de l'article : rendu par blocs pour préserver les balises h2/h3 sémantiqu %>
      <%# simple_format entourerait les h2 de <p> (HTML invalide), donc on itère bloc par bloc %>
      <div class="blog-show__body">
        <% @article.body.split(/\n\n+/).each do |bloc| %>
          <% bloc = bloc.strip %>
          <% next if bloc.blank? %>
          <%# Blocs qui commencent par une balise HTML bloc (h2, h3, ul, ol) → rendu direct.
              sanitize (allowlist) plutôt que html_safe : le contenu est admin-only mais on
              neutralise tout <script>/onload… par défense en profondeur, sans perdre la
              structure sémantique voulue. %>
          <% if bloc.start_with?('<h2>', '<h3>', '<ul>', '<ol>') %>
            <%= sanitize bloc,
                         tags: %w[h2 h3 h4 ul ol li p a strong em b i br blockquote],
                         attributes: %w[href target rel] %>
          <% else %>
            <%# Bloc de texte normal → transformé en paragraphe avec gestion des sauts de ligne %>
            <%= simple_format(bloc) %>
          <% end %>
        <% end %>
      </div>

      <%# Pied d'article : retour blog + CTA inscription %>
      <footer class="blog-show__footer">
        <%= link_to "← Retour au blog", articles_path, class: "blog-show__back" %>

        <div class="blog-show__cta">
          <p>Prêt à jouer ? Rejoins Teams-up gratuitement.</p>
          <%= link_to "Créer mon compte", new_user_registration_path, class: "btn btn-cta-primary" %>
        </div>
      </footer>

    </div>
  </div>
</div>
