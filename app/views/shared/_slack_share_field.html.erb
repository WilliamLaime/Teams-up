<%# ── Champ de partage Slack (formulaires de création + modale de partage) ────── %>
<%#
  Locals attendus :
    workspaces : tableau [{ id:, name:, destinations: { "Channels" => [[nom,id]...],
                 "Messages directs" => [[nom,id]...] }, favorites: [[nom,id]...],
                 needs_reinstall: bool }] (peut être vide)
    standalone : (optionnel, défaut false) mode modale de partage manuel — on omet
                 la case « Partager sur Slack » (le partage est l'intention explicite)
                 et la destination reste toujours visible.
  N'affiche rien si l'utilisateur n'a pas lié Slack.

  Sélection en DEUX temps :
    1. le workspace Slack (masqué s'il n'y en a qu'un → champ caché)
    2. la destination : COMBOBOX recherchable (slack-destination) avec favoris épinglés,
       alimenté par les données embarquées. Un champ caché `slack_channel_id` porte l'id
       choisi (vide = destination par défaut) — le controller lit ce param inchangé.

  Deux contrôleurs Stimulus sur la racine :
    - slack-share       : case « Partager » + visibilité du bloc
    - slack-destination : combobox recherchable + favoris
%>
<% standalone = local_assigns.fetch(:standalone, false) %>
<% if current_user.slack_linked? %>
  <div class="slack-share-field <%= "mb-4" unless standalone %>"
       data-controller="slack-share slack-destination"
       data-slack-destination-workspaces-value="<%= workspaces.to_json %>">
    <% unless standalone %>
      <div class="form-check mb-2">
        <%= check_box_tag :post_to_slack, "1", false,
              class: "form-check-input",
              data: { action: "slack-share#toggle", slack_share_target: "checkbox" } %>
        <%= label_tag :post_to_slack, class: "form-check-label" do %>
          <%= render "shared/slack_logo", size: 16 %>
          Partager sur Slack à la création
        <% end %>
      </div>
    <% end %>

    <% if workspaces.present? %>
      <%# En mode formulaire : masqué tant que la case n'est pas cochée (Stimulus).
          En mode standalone (modale) : toujours visible. %>
      <div data-slack-share-target="wrapper" style="<%= "display:none;" unless standalone %>">
        <% if workspaces.any? { |w| w[:needs_reinstall] } %>
          <%# Connexion Slack expirée (token du bot révoqué/invalide) : relier l'identité
              ne répare PAS — il faut réinstaller l'app pour obtenir un nouveau bot_token. %>
          <div class="alert alert-warning small mb-3" role="alert">
            <i data-lucide="alert-triangle" style="width:16px; height:16px; vertical-align:-3px;"></i>
            La connexion à ton espace Slack a expiré. Les destinations ne peuvent plus être
            chargées — <%= link_to "réinstalle l'app Teams-up", slack_install_path, class: "alert-link" %>
            (réservé aux admins Slack) pour la rétablir.
          </div>
        <% end %>
        <% if workspaces.size > 1 %>
          <div class="mb-2">
            <%# Couleur theme-aware (pas le .text-muted fixe de Bootstrap, illisible sur fond sombre) %>
            <%= label_tag :slack_workspace_id, "Espace Slack",
                  class: "form-label small", style: "color: var(--theme-text-muted);" %>
            <%= select_tag :slack_workspace_id,
                  options_for_select(workspaces.map { |w| [w[:name], w[:id]] }),
                  class: "form-select",
                  data: { slack_destination_target: "workspace",
                          action: "slack-destination#workspaceChanged" } %>
          </div>
        <% else %>
          <%# Un seul workspace → pas de choix, on le transmet en champ caché. %>
          <%= hidden_field_tag :slack_workspace_id, workspaces.first[:id],
                data: { slack_destination_target: "workspace" } %>
        <% end %>

        <%= label_tag :slack_channel_id, "Destination (channel ou message direct)",
              class: "form-label small", style: "color: var(--theme-text-muted);" %>

        <%# Combobox recherchable. Le champ caché porte l'id soumis (vide = défaut). %>
        <%= hidden_field_tag :slack_channel_id, "", data: { slack_destination_target: "hidden" } %>
        <div class="slack-dest">
          <div class="slack-dest-group">
            <span class="slack-dest-search-icon" aria-hidden="true">
              <i data-lucide="search" style="width:15px;height:15px;"></i>
            </span>
            <input type="text"
                   class="slack-dest-input"
                   placeholder="Ma destination par défaut"
                   autocomplete="off"
                   role="combobox"
                   aria-expanded="false"
                   aria-autocomplete="list"
                   aria-controls="slack-dest-list"
                   data-slack-destination-target="input"
                   data-action="focus->slack-destination#open input->slack-destination#filter keydown->slack-destination#keydown">
          </div>
          <ul class="slack-dest-list"
              id="slack-dest-list"
              role="listbox"
              data-slack-destination-target="list"
              style="display:none;"></ul>
        </div>
      </div>
    <% else %>
      <p class="text-muted small mb-0">Le match sera posté dans ta destination Slack par défaut.</p>
    <% end %>
  </div>
<% end %>
