<%# =====================================================
   MOBILE SUB-NAVBAR — Bande visible uniquement sur mobile (< lg)
   Affichée juste sous la navbar principale.
   - Connecté     : bouton "Créer un match" centré (CTA rapide, 1 tap)
   - Non connecté : boutons Se connecter + S'inscrire
   Les autres liens (Trouver, Équipes, etc.) sont dans le drawer burger.
   ===================================================== %>

<div class="mobile-sub-navbar d-lg-none">
  <div class="container">

    <% if user_signed_in? %>

      <%# CTA "Créer un match" — toujours accessible en 1 tap sans ouvrir le drawer %>
      <div class="d-flex justify-content-center">
        <%= link_to new_match_path,
            class: "btn btn-primary btn-sm px-4 btn-cta-primary d-flex align-items-center gap-1" do %>
          <i data-lucide="plus" style="width:13px;height:13px;" aria-hidden="true"></i>
          Créer un match
        <% end %>
      </div>

    <% else %>

      <%# ── Boutons Se connecter / S'inscrire (non connecté) ── %>
      <div class="d-flex justify-content-center align-items-center gap-3">
        <%= link_to "Se connecter", new_user_session_path, class: "btn-cta-link" %>
        <%= link_to new_user_registration_path,
            class: "btn btn-primary btn-sm px-3 btn-cta-primary" do %>
          S'inscrire
        <% end %>
      </div>

    <% end %>

  </div>
</div>
