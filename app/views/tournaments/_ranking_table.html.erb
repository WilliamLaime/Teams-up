<%# ── Table de classement ───────────────────────────────────────────────────────
    Locals : players (déjà triés), tournament (sport → barème V/N/D, Lot 6).
    Réutilisé pour le classement global (suisse / championnat) et pour chaque poule.
    La colonne "N" (nuls) n'apparaît que pour les sports où le nul existe.
    La colonne "Sets" n'apparaît que pour les sports joués en sets (tennis, padel,
    badminton, ping-pong, volley) — pour les sports à score simple (football,
    handball, basketball), le différentiel de sets vaudrait toujours V-D, donc
    aucune info en plus (le différentiel de points/buts, colonne "+/-", suffit).
    "Pts" (points de classement, barème V/N/D du sport) et "+/-" (différentiel de
    points/buts marqués-encaissés) sont deux notions distinctes qui n'ont aucun
    rapport entre elles — nommées "+/-" (pas "Points") pour éviter toute confusion
    avec "Pts", vu à tort comme "points pour la victoire" alors qu'il s'agit d'un
    écart de score.
    Qualification (format poules) : pas de colonne dédiée (retirée, cf. "État"
    ci-dessus) mais une icône check-circle discrète à côté du nom, dès que
    `tu.qualified?` (state posé par PoolBuilder#start_playoffs! sur les 2 premiers
    de chaque poule une fois la phase de poules terminée) — répond au besoin de
    voir qui est qualifié DANS chaque poule sans réintroduire un texte redondant. %>
<%# compact (optionnel, défaut false) : version réduite à « # / Joueur / V / D »,
    pour la colonne latérale du sélecteur de poules (_pool_phase). Huit colonnes
    n'y tiendraient pas sans scroll horizontal permanent, et le détail (points de
    classement, différentiels) reste à un clic dans l'onglet Classement — qui, lui,
    garde la table complète. %>
<% compact = local_assigns.fetch(:compact, false) %>
<%# destinations (optionnel, défaut false) : liseré + icône annonçant où chaque
    position de poule ira en phase finale (Critérium). OPT-IN volontaire — dériver
    la valeur ici rendrait le HTML de la ronde suisse, du championnat et du format
    « poules » dépendant d'un helper qui ne les concerne pas ; avec le défaut à
    false, il reste byte-identique. %>
<% destinations = local_assigns.fetch(:destinations, false) %>
<% show_draws = !compact && tournament.sport&.ranking_points_rules&.dig(:draw)&.positive? %>
<% show_sets  = !compact && tournament.sport&.scoring_rules&.dig(:mode) == :sets %>
<div class="tournament-ranking__scroll">
  <table class="tournament-ranking__table <%= "tournament-ranking__table--compact" if compact %>">
    <thead>
      <tr>
        <th class="is-rank">#</th>
        <th class="is-player">Joueur</th>
        <% unless compact %><th title="Points de classement">Pts</th><% end %>
        <th title="Victoires">V</th>
        <% if show_draws %><th title="Nuls">N</th><% end %>
        <th title="Défaites">D</th>
        <% if show_sets %><th title="Différentiel de sets">Sets</th><% end %>
        <% unless compact %><th title="Différentiel de points marqués/encaissés">+/-</th><% end %>
      </tr>
    </thead>
    <tbody>
      <% players.each_with_index do |tu, index| %>
        <% mine = my_player?(tu) %>
        <% destination = pool_destination_for(tournament, tu) if destinations %>
        <tr class="tournament-ranking__row tournament-ranking__row--<%= tu.state %> <%= "is-me" if mine %>
                   <%= "tournament-ranking__row--dest-#{destination}" if destination %>">
          <td class="is-rank"><%= index + 1 %></td>
          <td class="is-player">
            <%= link_to user_profil_path(tu.user), class: "tournament-ranking__player-link" do %>
              <%= user_avatar_tag tu.user, css_class: "tournament-ranking__avatar" %>
              <span><%= tu.display_name %></span>
            <% end %>
            <%# Repère « moi » : dans un classement à 32 lignes, retrouver sa place
                demande sinon de lire chaque nom. %>
            <%= me_badge if mine %>
            <%# Forfait : la ligne est déjà barrée et atténuée par le modificateur
                --withdrawn, la pastille dit POURQUOI. %>
            <% if tu.withdrawn? %>
              <span class="tournament-ranking__forfeit" title="Forfait" aria-label="Forfait">F</span>
            <% end %>
            <% if tu.qualified? %>
              <i data-lucide="check-circle" class="tournament-ranking__qualified-icon"
                 title="Qualifié pour le tableau final" aria-label="Qualifié pour le tableau final"></i>
            <%# `elsif` et non un second `if` : un joueur ne doit jamais porter deux
                fois le même message. La destination est une PRÉDICTION, elle
                s'efface donc dès que la qualification est acquise. %>
            <% elsif destination %>
              <i data-lucide="<%= destination_icon(destination) %>"
                 class="tournament-ranking__destination-icon tournament-ranking__destination-icon--<%= destination %>"
                 title="<%= destination_label(destination) %>" aria-label="<%= destination_label(destination) %>"></i>
            <% end %>
          </td>
          <% unless compact %><td class="is-num is-pts"><%= tu.ranking_points %></td><% end %>
          <td class="is-num is-win"><%= tu.wins %></td>
          <% if show_draws %><td class="is-num"><%= tu.draws %></td><% end %>
          <td class="is-num"><%= tu.losses %></td>
          <% if show_sets %>
            <td class="is-num"><%= tu.set_average.positive? ? "+#{tu.set_average}" : tu.set_average %></td>
          <% end %>
          <% unless compact %>
            <td class="is-num"><%= tu.point_average.positive? ? "+#{tu.point_average}" : tu.point_average %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
