<%# ── Matchs de classement du Critérium Fédéral ───────────────────────────────
    Les mini-tableaux qui font jouer les places au-delà du podium : 3e/4e, 5e-8e,
    9e-16e… et leurs équivalents en consolante. Ils tournent EN PARALLÈLE du
    tableau principal (le match pour la 3e place se joue pendant que la finale se
    joue), d'où un bloc par branche plutôt qu'un ruban unique.

    Un bloc = une branche = un nœud de CriteriumStructure, titré par la plage de
    places qu'il attribue. Les colonnes ne sont titrées que s'il y a plusieurs
    tours : pour un match unique, « Finale » serait redondant avec « Match pour la
    3e place ». CHAQUE place se jouant, un tableau de 16 produit ici 7 branches
    par côté — les blocs sont triés par première place attribuée, si bien qu'un
    mini-tableau apparaît avant ceux nés de ses propres perdants.

    Local : tournament. %>
<section class="tournament-phase" data-tournament-phase-switch-target="section" data-phase="classification"
         <%= "hidden" if phase_section_hidden?(tournament, "classification") %>>
  <h2 class="tournament-phase__title">Matchs de classement</h2>

  <% classification_tables(tournament).each do |node, rounds| %>
    <h3 class="tournament-phase__subtitle"><%= node.label %></h3>

    <div class="bracket">
      <% rounds.each_with_index do |round, index| %>
        <div class="bracket__round">
          <% if rounds.size > 1 %>
            <div class="bracket__round-title"><%= bracket_stage_label(index, rounds.size) %></div>
          <% end %>
          <%# Une case par POSITION prévue, pas par match existant : ces
              mini-tableaux se construisent au fur et à mesure comme le tableau
              final (cf. BracketBuilder en mode incrémental), donc un tour peut
              n'avoir qu'un de ses deux matchs. Sans cela la case manquante
              disparaîtrait et la colonne se désalignerait. %>
          <% slots  = round.expected_matches || node.size / (2**(index + 1)) %>
          <% placed = round.tournament_matches.order(:position).index_by(&:position) %>
          <% feeders = index.positive? ? rounds[index - 1].tournament_matches.index_by(&:position) : {} %>
          <div class="bracket__matches">
            <% slots.times do |position| %>
              <% if (match = placed[position]) %>
                <%= render "tournaments/tmatch", match: match %>
              <% else %>
                <%= render "tournaments/bracket_placeholder_cell",
                           player_a: feeders[position * 2]&.winner,
                           player_b: feeders[(position * 2) + 1]&.winner,
                           from_a: bracket_feeder_label(index, position * 2, rounds.size),
                           from_b: bracket_feeder_label(index, (position * 2) + 1, rounds.size) %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
