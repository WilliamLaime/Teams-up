<%# ── Phase de poules ───────────────────────────────────────────────────────────
    Ruban horizontal : une colonne par journée, matchs regroupés par poule à
    l'intérieur de chaque colonne (Poule A, B… — cf. _round_column,
    group_by_pool: true, dérivé de player_a.pool).
    Locals : tournament, can_manage. %>
<section class="tournament-phase">
  <h2 class="tournament-phase__title">Poules</h2>

  <%= render "tournaments/round_ribbon", rounds: tournament.pool_rounds, can_manage: can_manage,
              title_for: ->(round) { "Journée #{round.number}" }, group_by_pool: true %>
</section>
