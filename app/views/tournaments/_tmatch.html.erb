<%# ── Carte d'un match de tournoi ─────────────────────────────────────────────
    Affiche les deux joueurs (ou l'exempt pour un bye). Si l'utilisateur gère le
    tournoi et que le match est en attente, deux boutons désignent le vainqueur. %>
<div id="tmatch_<%= match.id %>" class="tmatch-card <%= "tmatch-card--bye" if match.is_bye %> <%= "tmatch-card--done" if match.decided? %>">
  <% if match.is_bye %>
    <div class="tmatch-card__player tmatch-card__player--winner">
      <%= user_avatar_tag match.player_a.user, css_class: "tmatch-card__avatar" %>
      <span class="tmatch-card__name"><%= match.player_a.display_name %></span>
    </div>
    <span class="tmatch-card__bye-badge">Exempt (qualifié d'office)</span>
  <% else %>
    <% match.players.each do |player| %>
      <% is_winner = match.decided? && match.winner_id == player.id %>
      <div class="tmatch-card__player <%= "tmatch-card__player--winner" if is_winner %> <%= "tmatch-card__player--loser" if match.decided? && !is_winner %>">
        <%= user_avatar_tag player.user, css_class: "tmatch-card__avatar" %>
        <span class="tmatch-card__name"><%= player.display_name %></span>

        <% if is_winner %>
          <i data-lucide="check" class="tmatch-card__win-icon" aria-hidden="true"></i>
        <% elsif can_manage && !match.decided? %>
          <%= button_to tournament_tournament_match_path(match.tournament, match),
                        method: :patch,
                        params: { tournament_match: { winner_id: player.id } },
                        class: "tmatch-card__win-btn",
                        title: "Désigner #{player.display_name} vainqueur" do %>
            Vainqueur
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
