<%# ── Onglet « Classement » ─────────────────────────────────────────────────────
    Table triée des joueurs (victoires puis set/point average — mêmes critères que
    le seeding). Pour le format « poules », un classement PAR poule. N'a de sens
    qu'une fois le tournoi lancé. Local : tournament. %>
<div class="tournament-ranking">
  <% if tournament.completed? %>
    <%= render "tournaments/champion_banner", tournament: tournament %>
  <% end %>

  <% if tournament.tournament_rounds.any? %>
    <%# Critérium : les places jouées d'abord, le bilan par poule ensuite. %>
    <% if tournament.criterium? %>
      <%= render "tournaments/final_standings", tournament: tournament %>
    <% end %>

    <% if Tournament::POOL_BASED_FORMATS.include?(tournament.format) && tournament.pools.any? %>
      <% tournament.ranked_pools.each do |pool_index, players| %>
        <h3 class="tournament-ranking__pool-title">Poule <%= ("A".ord + pool_index.to_i).chr %></h3>
        <%= render "tournaments/ranking_table", players: players, tournament: tournament %>
      <% end %>
    <% else %>
      <%= render "tournaments/ranking_table", players: tournament.ranked_players, tournament: tournament %>
    <% end %>
  <% else %>
    <p class="tournament-empty">Le classement apparaîtra une fois le tournoi lancé.</p>
  <% end %>
</div>
