<%# ── Liste des tournois (/tournois) ─────────────────────────────────────────── %>
<% content_for :title, "Tournois" %>
<% content_for :breadcrumb, breadcrumb_for([["Tournois", nil]]) %>

<div class="tournaments-index-page">
  <div class="container">

    <%# ── En-tête ──────────────────────────────────────────────────────────── %>
    <div class="tournaments-index-header">
      <%= render "shared/nav_button", fallback: root_path, label: "Retour", direction: "back", extra_class: "mb-2" %>

      <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
        <div>
          <h1 class="tournaments-index-title">Tournois</h1>
          <p class="tournaments-index-subtitle mb-0">Rejoignez la compétition. Dominez le terrain.</p>
        </div>
        <% if user_signed_in? %>
          <%= render "shared/btn_primary", url: new_tournament_path, text: "Créer un tournoi", icon: "plus" %>
        <% end %>
      </div>
    </div>

    <%# ── Barre recherche + filtres sport ──────────────────────────────────── %>
    <%= form_with url: tournaments_path, method: :get do |f| %>
      <%# Onglet courant conservé quand on filtre par recherche/sport, sinon on
          retomberait silencieusement sur l'onglet par défaut. %>
      <%= hidden_field_tag :tab, @active_tab %>
      <div class="tournaments-filters-bar">
        <%# Recherche libre %>
        <div class="filter-search-wrap">
          <i data-lucide="search" style="width:16px;height:16px;" class="filter-search-icon"></i>
          <label class="visually-hidden" for="query">Rechercher un tournoi</label>
          <%= text_field_tag :query, params[:query],
                placeholder: "Rechercher un tournoi…",
                class: "filter-search-input",
                onchange: "this.form.requestSubmit()" %>
        </div>

        <%# Filtres sport (pills) — "Tous" + un lien par sport %>
        <div class="tournaments-sport-filters">
          <%= link_to "Tous", tournaments_path(query: params[:query], tab: @active_tab),
                class: "tournament-sport-pill #{'active' if params[:sport].blank?}" %>
          <% @sports.each do |sport| %>
            <%= link_to tournaments_path(sport: sport.slug, query: params[:query], tab: @active_tab),
                  class: "tournament-sport-pill #{'active' if params[:sport] == sport.slug}" do %>
              <%= sport_icon(sport, size: "0.85rem") %>
              <%= sport.name %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# ── Barre d'onglets : Mes tournois / À rejoindre / En cours / Terminés ── %>
    <nav class="tournaments-index-tabs" aria-label="Filtrer par catégorie">
      <% if user_signed_in? %>
        <%= link_to tournaments_path(tab: "mine", query: params[:query], sport: params[:sport]),
              class: "tournaments-index-tabs__tab #{'is-active' if @active_tab == :mine}" do %>
          <i data-lucide="zap" aria-hidden="true"></i>
          Mes tournois
          <span class="tournaments-index-tabs__count"><%= @tab_counts[:mine] %></span>
        <% end %>
      <% end %>
      <%= link_to tournaments_path(tab: "join", query: params[:query], sport: params[:sport]),
            class: "tournaments-index-tabs__tab #{'is-active' if @active_tab == :join}" do %>
        Tournois à rejoindre
        <span class="tournaments-index-tabs__count"><%= @tab_counts[:join] %></span>
      <% end %>
      <%= link_to tournaments_path(tab: "ongoing", query: params[:query], sport: params[:sport]),
            class: "tournaments-index-tabs__tab #{'is-active' if @active_tab == :ongoing}" do %>
        Tournois en cours
        <span class="tournaments-index-tabs__count"><%= @tab_counts[:ongoing] %></span>
      <% end %>
      <%= link_to tournaments_path(tab: "completed", query: params[:query], sport: params[:sport]),
            class: "tournaments-index-tabs__tab #{'is-active' if @active_tab == :completed}" do %>
        <i data-lucide="check-circle-2" aria-hidden="true"></i>
        Tournois terminés
        <span class="tournaments-index-tabs__count"><%= @tab_counts[:completed] %></span>
      <% end %>
    </nav>

    <%# ── Grille de l'onglet actif + pagination ─────────────────────────────── %>
    <% if @tournaments.empty? %>
      <div class="tournaments-empty-state">
        <i data-lucide="trophy" style="width:48px;height:48px;" aria-hidden="true"></i>
        <p><%= tab_empty_message(@active_tab) %></p>
      </div>
    <% else %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% @tournaments.each do |tournament| %>
          <div class="col">
            <%= render "shared/tournament_card", tournament: tournament %>
          </div>
        <% end %>
      </div>

      <% if @pagy.pages > 1 %>
        <nav class="tournaments-pagination mt-5 d-flex justify-content-center" aria-label="Pagination des tournois">
          <%== pagy_bootstrap_nav(@pagy) %>
        </nav>
      <% end %>
    <% end %>

  </div>
</div>
