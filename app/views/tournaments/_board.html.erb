<%# ── Board du tournoi ────────────────────────────────────────────────────────
    Aiguillage selon l'état :
      • open/closed → bouton « Lancer le tournoi » (organisateur) ou message d'attente
      • in_progress → rondes suisses + tableau final
      • completed   → idem, avec le vainqueur mis en avant
    `can_manage` = l'utilisateur peut saisir les résultats / lancer (admin ou co-org). %>
<% can_manage = user_signed_in? && policy(tournament).manage? %>

<%# Terminer le tournoi : dispo tant qu'il n'est pas déjà terminé (abandon avant/
    pendant le tournoi, en plus de la fin automatique posée par BracketBuilder). %>
<% if can_manage && !tournament.completed? %>
  <div class="tournament-finish-action">
    <%= button_to finish_tournament_path(tournament),
                  method: :patch,
                  class: "btn-cta-secondary tournament-finish-action__btn",
                  data: { turbo_confirm: "Terminer ce tournoi maintenant ? " \
                                         "Les matchs non joués resteront sans résultat.",
                          turbo_confirm_accept: "Terminer le tournoi" } do %>
      <i data-lucide="flag" aria-hidden="true"></i>
      Terminer le tournoi
    <% end %>
  </div>
<% end %>

<% if tournament.open? || tournament.closed? %>
  <%= render "tournaments/start_panel", tournament: tournament, can_manage: can_manage %>
<% else %>
  <% if tournament.completed? %>
    <%= render "tournaments/champion_banner", tournament: tournament %>
  <% end %>

  <%# data-phase="main" (ronde robin, un seul des 3 formats existe) vs "bracket" (tableau
      final) : le sélecteur de phase (_phase_nav) bascule leur visibilité une fois le
      tableau final démarré (avant ça, une seule des deux existe, rien à basculer). %>
  <%# storage-key : la phase choisie survit au turbo_stream.update du board déclenché
      par chaque saisie de score (sinon retour forcé à la phase la plus avancée).
      Clé par tournoi — deux tournois ouverts dans le même onglet ne se marchent pas
      sur les pieds. %>
  <div class="tournament-board__phases" data-controller="tournament-phase-switch"
       data-tournament-phase-switch-default-value="<%= default_board_phase(tournament) %>"
       data-tournament-phase-switch-storage-key-value="phase:<%= tournament.id %>">
    <%= render "tournaments/phase_nav", tournament: tournament %>

    <%# Phase suisse : une section par ronde, matchs groupés par nombre de victoires. %>
    <% if tournament.swiss_rounds.any? %>
      <section class="tournament-phase" data-tournament-phase-switch-target="section" data-phase="main">
        <h2 class="tournament-phase__title">Ronde Suisse</h2>
        <%= render "tournaments/round_ribbon", rounds: tournament.swiss_rounds,
                    title_for: ->(round) { "Ronde #{round.number}" }, group_by_record: true,
                    extra_columns: render("tournaments/qualification_panel", tournament: tournament) %>
      </section>
    <% end %>

    <%# Championnat : round-robin intégral, une section par journée. %>
    <% if tournament.league_rounds.any? %>
      <section class="tournament-phase" data-tournament-phase-switch-target="section" data-phase="main">
        <h2 class="tournament-phase__title">Championnat</h2>
        <%= render "tournaments/round_ribbon", rounds: tournament.league_rounds,
                    title_for: ->(round) { "Journée #{round.number}" }, paginated: true %>
      </section>
    <% end %>

    <%# Poules : round-robin par poule, matchs groupés par poule dans chaque journée. %>
    <% if tournament.pool_rounds.any? %>
      <%= render "tournaments/pool_phase", tournament: tournament %>
    <% end %>

    <%# Barrages (Critérium Fédéral) : palier entre les poules et le tableau final. %>
    <% if tournament.barrage_rounds.any? %>
      <%= render "tournaments/barrage_phase", tournament: tournament %>
    <% end %>

    <%# Tableau final / playoffs à élimination directe (commun à tous les formats).
        Affiché dès que le tournoi est lancé (structure complète avec cases "À
        déterminer", cf. _bracket.html.erb), pas seulement une fois le tableau
        réellement démarré — sauf championnat SANS playoffs, qui n'a jamais de
        bracket_rounds (le tournoi se termine à la dernière journée), cf.
        Tournament#bracket_expected? (PAS juste `playoffs?`, qui n'a de sens que
        pour le championnat et peut valoir n'importe quoi pour les autres formats). %>
    <% if (tournament.in_progress? || tournament.completed?) && tournament.bracket_expected? %>
      <%= render "tournaments/bracket", tournament: tournament %>
    <% end %>

    <%# Critérium Fédéral : la consolante et les matchs de classement font jouer
        les places au-delà du podium. Contrairement au tableau final, ils ne
        s'affichent qu'une fois réellement ouverts — leur structure dépend des
        perdants des tours amont, il n'y a donc rien à préfigurer avant. %>
    <% if tournament.tournament_rounds.consolation.exists? %>
      <%= render "tournaments/consolation_phase", tournament: tournament %>
    <% end %>

    <% if classification_tables(tournament).any? %>
      <%= render "tournaments/classification_phase", tournament: tournament %>
    <% end %>
  </div>
<% end %>
