<%# ── Board du tournoi ────────────────────────────────────────────────────────
    Aiguillage selon l'état :
      • open/closed → bouton « Lancer le tournoi » (organisateur) ou message d'attente
      • in_progress → rondes suisses + tableau final
      • completed   → idem, avec le vainqueur mis en avant
    `can_manage` = l'utilisateur peut saisir les résultats / lancer (admin ou co-org). %>
<% can_manage = user_signed_in? && policy(tournament).manage? %>

<%# Terminer le tournoi : dispo tant qu'il n'est pas déjà terminé (abandon avant/
    pendant le tournoi, en plus de la fin automatique posée par BracketBuilder). %>
<% if can_manage && !tournament.completed? %>
  <div class="tournament-finish-action">
    <%= button_to finish_tournament_path(tournament),
                  method: :patch,
                  class: "btn-cta-secondary tournament-finish-action__btn",
                  data: { turbo_confirm: "Terminer ce tournoi maintenant ?" } do %>
      <i data-lucide="flag" aria-hidden="true"></i>
      Terminer le tournoi
    <% end %>
  </div>
<% end %>

<% if tournament.open? || tournament.closed? %>
  <%= render "tournaments/start_panel", tournament: tournament, can_manage: can_manage %>
<% else %>
  <% if tournament.completed? && (champion = tournament.bracket_rounds.last&.tournament_matches&.first&.winner) %>
    <div class="tournament-champion">
      <i data-lucide="trophy" aria-hidden="true"></i>
      <span class="tournament-champion__label">Vainqueur</span>
      <strong class="tournament-champion__name"><%= champion.display_name %></strong>
    </div>
  <% end %>

  <%# Phase suisse : une section par ronde, matchs groupés par nombre de victoires. %>
  <% if tournament.swiss_rounds.any? %>
    <section class="tournament-phase">
      <h2 class="tournament-phase__title">Ronde Suisse</h2>
      <% tournament.swiss_rounds.each do |round| %>
        <%= render "tournaments/swiss_round", round: round, can_manage: can_manage %>
      <% end %>
    </section>
  <% end %>

  <%# Championnat : round-robin intégral, une section par journée. %>
  <% if tournament.league_rounds.any? %>
    <section class="tournament-phase">
      <h2 class="tournament-phase__title">Championnat</h2>
      <% tournament.league_rounds.each do |round| %>
        <%= render "tournaments/swiss_round", round: round, can_manage: can_manage, title: "Journée #{round.number}" %>
      <% end %>
    </section>
  <% end %>

  <%# Poules : round-robin par poule, matchs groupés par poule dans chaque journée. %>
  <% if tournament.pool_rounds.any? %>
    <%= render "tournaments/pool_phase", tournament: tournament, can_manage: can_manage %>
  <% end %>

  <%# Tableau final / playoffs à élimination directe (commun à tous les formats). %>
  <% if tournament.bracket_started? %>
    <%= render "tournaments/bracket", tournament: tournament, can_manage: can_manage %>
  <% end %>
<% end %>
