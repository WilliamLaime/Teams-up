<%# ── Carte compacte d'un match (bracket viewer, LECTURE SEULE) ─────────────────
    Variante allégée de _tmatch pour la « Vue d'ensemble » : joueurs + sets gagnés,
    vainqueur surligné. Aucun bouton, aucune dépendance à tournament-score /
    _score_modal (l'édition reste dans l'onglet Matchs). Classes .bracket-cell
    dédiées → aucune collision avec l'animation de tirage (qui vise .tmatch-card).
    Noms cliquables vers le profil (même principe que _tmatch__player-link) :
    seuls avatar + nom sont dans le lien, le score/badge restent en dehors.
    Local : match. %>
<div class="bracket-cell <%= "bracket-cell--bye" if match.is_bye %> <%= "bracket-cell--done" if match.decided? %>">
  <% if match.is_bye %>
    <div class="bracket-cell__player bracket-cell__player--winner">
      <%= link_to user_profil_path(match.player_a.user), class: "bracket-cell__player-link" do %>
        <%= user_avatar_tag match.player_a.user, css_class: "bracket-cell__avatar" %>
        <span class="bracket-cell__name"><%= match.player_a.display_name %></span>
      <% end %>
      <span class="bracket-cell__bye">Exempt</span>
    </div>
  <% else %>
    <% match.players.each do |player| %>
      <% is_winner = match.decided? && match.winner_id == player.id %>
      <div class="bracket-cell__player <%= "bracket-cell__player--winner" if is_winner %> <%= "bracket-cell__player--loser" if match.decided? && !is_winner %>">
        <%= link_to user_profil_path(player.user), class: "bracket-cell__player-link" do %>
          <%= user_avatar_tag player.user, css_class: "bracket-cell__avatar" %>
          <span class="bracket-cell__name <%= "is-withdrawn" if player.withdrawn? %>"><%= player.display_name %></span>
        <% end %>
        <%# Marque de forfait POSÉE HORS DU LIEN, comme le score : le lien ne
            contient qu'avatar + nom (cf. l'en-tête du fichier). Le score reste
            affiché quand il existe — un forfait n'en a pas. %>
        <% if match.score_entered? %>
          <span class="bracket-cell__score"><%= match.display_score_for(player) %></span>
        <% else %>
          <span class="bracket-cell__score"><%= forfeit_mark_tag(match, player) || "–" %></span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
