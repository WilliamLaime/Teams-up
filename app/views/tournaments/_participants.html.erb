<%# ── Onglet « Participants » ───────────────────────────────────────────────────
    Grille des joueurs approuvés + rappel des organisateurs (admin + co-orga).
    Local : tournament. %>
<%
  players      = tournament.approved_players
  co_organizers = tournament.co_organizers
%>

<div class="tournament-participants">

  <%# Organisateurs (n'occupent pas de place de joueur). %>
  <section class="tournament-participants__section">
    <h3 class="tournament-participants__title">
      <i data-lucide="shield" aria-hidden="true"></i> Organisation
    </h3>
    <div class="tournament-participants__grid">
      <% if tournament.user %>
        <div class="participant-chip participant-chip--admin">
          <%= user_avatar_tag tournament.user, css_class: "participant-chip__avatar" %>
          <span class="participant-chip__name"><%= tournament.user.display_name %></span>
          <span class="participant-chip__role">Admin</span>
        </div>
      <% end %>
      <% co_organizers.each do |tu| %>
        <div class="participant-chip participant-chip--admin">
          <%= user_avatar_tag tu.user, css_class: "participant-chip__avatar" %>
          <span class="participant-chip__name"><%= tu.display_name %></span>
          <span class="participant-chip__role">Co-organisateur</span>
        </div>
      <% end %>
    </div>
  </section>

  <%# Joueurs. %>
  <section class="tournament-participants__section">
    <h3 class="tournament-participants__title">
      <i data-lucide="users" aria-hidden="true"></i>
      Joueurs
      <span class="tournament-participants__count"><%= players.size %></span>
    </h3>

    <% if players.any? %>
      <div class="tournament-participants__grid">
        <% players.each do |tu| %>
          <div class="participant-chip">
            <%= user_avatar_tag tu.user, css_class: "participant-chip__avatar" %>
            <span class="participant-chip__name"><%= tu.display_name %></span>
            <% if tu.qualified? %>
              <span class="participant-chip__state participant-chip__state--qualified">Qualifié</span>
            <% elsif tu.eliminated? %>
              <span class="participant-chip__state participant-chip__state--eliminated">Éliminé</span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="tournament-empty">Aucun joueur inscrit pour le moment.</p>
    <% end %>
  </section>

</div>
