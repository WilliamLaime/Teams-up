<%# ── Détail d'un tournoi (/tournois/:id) ──────────────────────────────────────
    Vue à onglets : Vue d'ensemble · Matchs · Participants · Classement.
    Les onglets basculent côté client (contrôleur Stimulus tournament-tabs) sans
    recharger : les panneaux sont seulement masqués en CSS, jamais retirés du DOM.
    → #tournament_board (onglet Matchs) reste toujours présent, donc la saisie de
      score en Turbo Stream fonctionne quel que soit l'onglet affiché. %>
<% content_for :title, @tournament.name %>
<% content_for :breadcrumb, breadcrumb_for([["Tournois", tournaments_path], [@tournament.name, nil]]) %>

<%
  # Badge d'état (libellé + variante de couleur) — cohérent avec les overlays des cartes.
  status_badge = case @tournament.status
                 when "closed"      then { label: "Inscriptions closes", variant: "closed" }
                 when "in_progress" then { label: "En cours",   variant: "live" }
                 when "completed"   then { label: "Terminé",     variant: "done" }
                 else                    { label: "Inscriptions ouvertes", variant: "open" }
                 end

  # Libellé du compteur de joueurs. Trois cas, et non deux :
  #   - effectif LIBRE (aucun plafond) → "inscrits" : rien n'est "attendu", le
  #     compteur décrit ce qu'il y a, pas ce qu'il manque ;
  #   - preset 8/16/32 → "joueurs" (plafond ferme) ;
  #   - nombre saisi à la main → "participants attendus".
  plural_players = @tournament.approved_players_count > 1
  players_word = if @tournament.unlimited_capacity?
                    plural_players ? "inscrits" : "inscrit"
                  elsif @tournament.preset_capacity?
                    plural_players ? "joueurs" : "joueur"
                  else
                    plural_players ? "participants attendus" : "participant attendu"
                  end

  # Inscription de l'utilisateur courant, si elle existe. Sert au bouton d'action
  # de l'en-tête : #player? dit s'il occupe une place de joueur, la ligne elle-même
  # est nécessaire pour construire l'URL de désinscription (DELETE).
  # find sur l'association déjà préchargée → pas de requête supplémentaire.
  my_entry = current_user && @tournament.tournament_users.find { |tu| tu.user_id == current_user.id }
%>

<div class="tournaments-index-page">
  <div class="container">

    <%= render "shared/nav_button", url: tournaments_path, label: "Retour aux tournois", direction: "back", extra_class: "mb-3" %>

    <%# ── En-tête ─────────────────────────────────────────────────────────── %>
    <header class="tournament-detail-header">
      <div class="tournament-detail-header__top">
        <h1 class="tournament-detail-header__title"><%= @tournament.name %></h1>
        <span class="tournament-status-badge tournament-status-badge--<%= status_badge[:variant] %>">
          <%= status_badge[:label] %>
        </span>
        <% if policy(@tournament).update? %>
          <%= link_to edit_tournament_path(@tournament), class: "tournament-edit-link", title: "Modifier le tournoi" do %>
            <i data-lucide="pencil" style="width:16px;height:16px;" aria-hidden="true"></i>
          <% end %>
        <% end %>
      </div>
      <p class="tournament-detail-header__subtitle">
        <% if @tournament.sport %><%= @tournament.sport.name %> · <% end %>
        <%= Tournament::FORMAT_LABELS[@tournament.format] %>
        · <%= @tournament.approved_players_count %><% if @tournament.max_players %>/<%= @tournament.max_players %><% end %>
        <%= players_word %>
      </p>

      <%# ── Rejoindre / Quitter ──────────────────────────────────────────────
          Le seul autre point d'entrée est la carte de l'index, en onglet
          « À rejoindre » (cf. shared/_tournament_card) : qui arrive ici par un
          lien direct n'avait aucun moyen de s'inscrire. Mêmes routes que la carte. %>
      <div class="tournament-detail-header__actions">
        <% if @tournament.player?(current_user) %>
          <%# Une fois le tournoi lancé, on ne se désinscrit plus : le retrait passe
              par le forfait déclaré par l'organisateur (cf. WithdrawPlayer), sinon
              les matchs déjà générés se retrouveraient sans adversaire. %>
          <% if @tournament.open? || @tournament.closed? %>
            <%= button_to tournament_tournament_user_path(@tournament, my_entry),
                  method: :delete,
                  class: "btn-cta-secondary tournament-detail-header__action",
                  form: { data: { turbo_confirm: "Quitter le tournoi « #{@tournament.name} » ?" } },
                  data: { turbo_confirm_danger: true, turbo_confirm_accept: "Quitter" } do %>
              <i data-lucide="user-minus" aria-hidden="true"></i> Quitter le tournoi
            <% end %>
          <% else %>
            <span class="tournament-detail-header__enrolled">
              <i data-lucide="check" aria-hidden="true"></i> Tu joues ce tournoi
            </span>
          <% end %>
        <% elsif @tournament.registration_open? && !@tournament.full? %>
          <%# Vaut aussi pour un co-organisateur nommé sans être inscrit : il garde
              ses droits de gestion en rejoignant (cf. TournamentUsersController#create). %>
          <% if user_signed_in? %>
            <%= button_to tournament_tournament_users_path(@tournament),
                  method: :post,
                  class: "btn-cta-primary tournament-detail-header__action" do %>
              <i data-lucide="user-plus" aria-hidden="true"></i> Rejoindre le tournoi
            <% end %>
          <% else %>
            <%= link_to new_user_session_path, class: "btn-cta-primary tournament-detail-header__action" do %>
              <i data-lucide="user-plus" aria-hidden="true"></i> Rejoindre le tournoi
            <% end %>
          <% end %>
        <% end %>
      </div>
    </header>

    <%# ── Onglets ─────────────────────────────────────────────────────────── %>
    <div data-controller="tournament-tabs">
      <div class="tournament-tabs" role="tablist" aria-label="Sections du tournoi">
        <button type="button" class="tournament-tabs__tab" role="tab" aria-selected="false"
                data-tournament-tabs-target="tab" data-action="tournament-tabs#select"
                data-tournament-tabs-panel-param="overview">
          <i data-lucide="info" aria-hidden="true"></i> Vue d'ensemble
        </button>
        <button type="button" class="tournament-tabs__tab is-active" role="tab" aria-selected="true"
                data-tournament-tabs-target="tab" data-action="tournament-tabs#select"
                data-tournament-tabs-panel-param="matchs">
          <i data-lucide="swords" aria-hidden="true"></i> Matchs
        </button>
        <button type="button" class="tournament-tabs__tab" role="tab" aria-selected="false"
                data-tournament-tabs-target="tab" data-action="tournament-tabs#select"
                data-tournament-tabs-panel-param="participants">
          <i data-lucide="users" aria-hidden="true"></i> Participants
        </button>
        <button type="button" class="tournament-tabs__tab" role="tab" aria-selected="false"
                data-tournament-tabs-target="tab" data-action="tournament-tabs#select"
                data-tournament-tabs-panel-param="classement">
          <i data-lucide="list-ordered" aria-hidden="true"></i> Classement
        </button>
        <button type="button" class="tournament-tabs__tab" role="tab" aria-selected="false"
                data-tournament-tabs-target="tab" data-action="tournament-tabs#select"
                data-tournament-tabs-panel-param="calendrier">
          <i data-lucide="calendar-days" aria-hidden="true"></i> Calendrier
        </button>
      </div>

      <%# La modale de score et le contrôleur tournament-score vivent HORS de
          #tournament_board (pour survivre à ses remplacements Turbo Stream) mais
          englobent les panneaux → la modale reste accessible depuis l'onglet Matchs. %>
      <div data-controller="tournament-score tmatch-chat">

        <section class="tournament-tabs__panel" role="tabpanel" hidden
                 data-tournament-tabs-target="panel" data-panel="overview">
          <%= render "tournaments/overview", tournament: @tournament %>
        </section>

        <section class="tournament-tabs__panel is-active" role="tabpanel"
                 data-tournament-tabs-target="panel" data-panel="matchs">
          <%# `?draw=1` : on arrive du lancement par le chemin HTML (sans Turbo
              Stream). On greffe alors le contrôleur d'animation ici, pour que le
              tirage soit mis en scène comme sur le chemin Turbo. Le paramètre
              disparaît à la navigation suivante — l'animation ne rejoue donc pas. %>
          <% drawing = params[:draw].present? %>
          <div id="tournament_board" class="tournament-board"
               data-controller="bracket<%= " tournament-draw" if drawing %>">
            <% if drawing && Tournament::POOL_BASED_FORMATS.include?(@tournament.format) %>
              <%= render "tournaments/draw_overlay", tournament: @tournament %>
            <% end %>
            <%= render "tournaments/board", tournament: @tournament %>
          </div>
        </section>

        <section class="tournament-tabs__panel" role="tabpanel" hidden
                 data-tournament-tabs-target="panel" data-panel="participants">
          <div id="tournament_participants">
            <%= render "tournaments/participants", tournament: @tournament %>
          </div>
        </section>

        <section class="tournament-tabs__panel" role="tabpanel" hidden
                 data-tournament-tabs-target="panel" data-panel="classement">
          <%= render "tournaments/ranking", tournament: @tournament %>
        </section>

        <section class="tournament-tabs__panel" role="tabpanel" hidden
                 data-tournament-tabs-target="panel" data-panel="calendrier">
          <%= render "tournaments/calendar", tournament: @tournament %>
        </section>

        <%= render "tournaments/score_modal" %>
        <%# Même raison que la modale de score : rendue ICI, hors de
            #tournament_board, pour survivre à ses remplacements Turbo Stream. %>
        <%= render "tournaments/tmatch_chat_modal" %>
      </div>
    </div>

  </div>
</div>
