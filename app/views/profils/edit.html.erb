<%# ── Page modification du profil ──────────────────────────────────────────── %>
<%# profil_path = GET /profil, qui rend show_simple (cf. routes.rb:190). %>
<% content_for :breadcrumb, breadcrumb_for([["Mon profil", profil_path], ["Modifier", nil]]) %>
<%# Même direction artistique que la page show : fond sombre, accents verts %>

<%# background-color géré par .profil-page dans _profil.scss (et _theme.scss en mode clair) %>
<div class="profil-page profil-edit-page" style="min-height:calc(100vh - 130px); padding:2.5rem 0 4rem; position:relative;">
  <div class="container" style="position:relative; z-index:1;">

    <%# ── Bouton retour ──────────────────────────────────────────────────── %>
    <%= render "shared/nav_button", label: "Retour", direction: "back", extra_class: "mb-4" %>

    <%# ── En-tête de page ────────────────────────────────────────────────── %>
    <%# .profil-page-title / .profil-page-subtitle : couleurs gérées par _theme.scss en light mode %>
    <div class="mb-4">
      <h1 class="profil-page-title" style="font-size:1.45rem; font-weight:800; color:#fff; margin:0; font-family:'Nunito', sans-serif;">
        Modifier mon profil
      </h1>
      <p class="profil-page-subtitle" style="font-size:0.85rem; color:rgba(255,255,255,0.4); margin:0.3rem 0 0;">
        Mets à jour tes informations personnelles
      </p>
      <%# Accès à la page de gestion des intégrations (Slack) %>
      <%= link_to profil_integrations_path, class: "btn btn-sm btn-outline-light mt-3" do %>
        <i data-lucide="plug" style="width:15px; height:15px; vertical-align:-3px;"></i>
        Intégrations (Slack)
      <% end %>
    </div>

    <%# ── Formulaire ─────────────────────────────────────────────────────── %>
    <%# On passe @profil en variable locale pour éviter d'utiliser une variable d'instance dans le partial %>
    <%= render "form", profil: @profil %>

  </div>
</div>
