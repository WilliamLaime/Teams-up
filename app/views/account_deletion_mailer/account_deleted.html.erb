<%# ── Email de confirmation de suppression de compte ─────────────────────── %>
<%# Envoyé à l'utilisateur après la suppression effective de son compte %>
<%# Utilise le layout commun mailer.html.erb (logo + DOCTYPE) %>
<%# Inline CSS obligatoire dans les emails — les clients mail ignorent les feuilles de style externes %>
<div style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; background-color: transparent; padding: 0 20px 40px; min-height: 100vh;">

  <%# Carte centrale %>
  <div style="max-width: 520px; margin: 0 auto; background-color: #1a1c1a; border-radius: 16px; border: 1px solid rgba(255,255,255,0.08); overflow: hidden;">

    <%# Corps du message %>
    <div style="padding: 36px 40px;">

      <%# Icône suppression %>
      <div style="text-align: center; margin-bottom: 24px;">
        <div style="display: inline-block; background-color: rgba(30, 221, 136, 0.12); border-radius: 50%; width: 64px; height: 64px; line-height: 64px; font-size: 28px;">
          🗑️
        </div>
      </div>

      <%# Titre %>
      <h1 style="color: #f0f0f0; font-size: 1.4rem; font-weight: 700; text-align: center; margin: 0 0 8px 0;">
        Ton compte a été supprimé
      </h1>

      <%# Sous-titre %>
      <p style="color: rgba(255,255,255,0.45); font-size: 0.9rem; text-align: center; margin: 0 0 28px 0;">
        Conformément au <strong style="color: rgba(255,255,255,0.7);">droit à l'oubli (RGPD, article 17)</strong>
      </p>

      <%# Salutation %>
      <p style="color: rgba(255,255,255,0.65); font-size: 0.95rem; line-height: 1.6; margin: 0 0 20px 0;">
        Salut <strong style="color: #f0f0f0;"><%= @user_name %></strong>,
      </p>

      <p style="color: rgba(255,255,255,0.65); font-size: 0.95rem; line-height: 1.6; margin: 0 0 28px 0;">
        Cet email confirme que ta demande de suppression de compte a été traitée avec succès.
      </p>

      <%# Détails de la suppression %>
      <div style="background-color: rgba(255,255,255,0.04); border-left: 3px solid #1EDD88; border-radius: 4px; padding: 16px 20px; margin-bottom: 24px;">
        <p style="color: rgba(255,255,255,0.4); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px; margin: 0 0 12px 0;">Détails</p>

        <%# Compte supprimé %>
        <p style="color: rgba(255,255,255,0.4); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px; margin: 0 0 2px 0;">Compte supprimé</p>
        <p style="color: #f0f0f0; font-size: 0.9rem; font-weight: 600; margin: 0 0 12px 0;"><%= @user_email %></p>

        <%# Date de suppression %>
        <p style="color: rgba(255,255,255,0.4); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px; margin: 0 0 2px 0;">Date et heure de suppression</p>
        <p style="color: #f0f0f0; font-size: 0.9rem; font-weight: 600; margin: 0;"><%= I18n.l(@deleted_at, format: :long) %></p>
      </div>

      <%# Liste des données supprimées %>
      <p style="color: #f0f0f0; font-size: 0.95rem; font-weight: 700; margin: 0 0 14px 0;">Données supprimées :</p>

      <div style="margin-bottom: 24px;">
        <p style="color: rgba(255,255,255,0.65); font-size: 0.85rem; line-height: 1.4; margin: 0 0 8px 0;">
          <span style="color: #1EDD88; margin-right: 8px;">✓</span> Profil personnel (prénom, nom, avatar)
        </p>
        <p style="color: rgba(255,255,255,0.65); font-size: 0.85rem; line-height: 1.4; margin: 0 0 8px 0;">
          <span style="color: #1EDD88; margin-right: 8px;">✓</span> Historique des matchs créés ou rejoints
        </p>
        <p style="color: rgba(255,255,255,0.65); font-size: 0.85rem; line-height: 1.4; margin: 0 0 8px 0;">
          <span style="color: #1EDD88; margin-right: 8px;">✓</span> Équipes captainées (transfert du capitanat ou suppression)
        </p>
        <p style="color: rgba(255,255,255,0.65); font-size: 0.85rem; line-height: 1.4; margin: 0 0 8px 0;">
          <span style="color: #1EDD88; margin-right: 8px;">✓</span> Messages privés et conversations
        </p>
        <p style="color: rgba(255,255,255,0.65); font-size: 0.85rem; line-height: 1.4; margin: 0 0 8px 0;">
          <span style="color: #1EDD88; margin-right: 8px;">✓</span> Avis reçus et donnés
        </p>
        <p style="color: rgba(255,255,255,0.65); font-size: 0.85rem; line-height: 1.4; margin: 0 0 8px 0;">
          <span style="color: #1EDD88; margin-right: 8px;">✓</span> Statistiques et accomplissements
        </p>
      </div>

      <%# Avertissement matchs futurs %>
      <div style="background-color: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 16px 20px; margin-bottom: 24px;">
        <p style="color: #f0f0f0; font-size: 0.9rem; line-height: 1.5; margin: 0;">
          <strong>⚠️ Matchs futurs :</strong> Tes matchs futurs ont été <strong>annulés automatiquement</strong>,
          et les participants en ont été notifiés par email.
        </p>
      </div>

      <%# Notice légale RGPD %>
      <div style="background-color: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 16px 20px; margin-bottom: 24px;">
        <p style="color: #f0f0f0; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; margin: 0 0 10px 0;">
          Informations légales — RGPD (article 17)
        </p>
        <p style="color: rgba(255,255,255,0.5); font-size: 0.82rem; line-height: 1.6; margin: 0 0 8px 0;">
          Conformément au Règlement Général sur la Protection des Données (RGPD),
          nous avons appliqué ton droit à l'oubli. Tes données personnelles ont été supprimées
          de notre système.
        </p>
        <p style="color: rgba(255,255,255,0.5); font-size: 0.82rem; line-height: 1.6; margin: 0;">
          Les données supprimées ne peuvent être récupérées. Si tu souhaites te réinscrire,
          tu devras créer un nouveau compte.
        </p>
      </div>

      <%# Lien contact support %>
      <p style="color: rgba(255,255,255,0.5); font-size: 0.85rem; line-height: 1.5; margin: 0;">
        Si tu as des questions ou si tu crois qu'une erreur a été commise,
        <a href="mailto:support@team-up.com" style="color: #1EDD88; text-decoration: none;">contacte notre support</a>.
      </p>

    </div>

    <%# Pied de page %>
    <div style="background-color: #111111; padding: 20px 40px; text-align: center; border-top: 1px solid rgba(255,255,255,0.06);">
      <p style="color: rgba(255,255,255,0.25); font-size: 0.78rem; margin: 0;">
        © <%= Date.today.year %> Teams-Up — Tous droits réservés.
      </p>
    </div>

  </div>
</div>
