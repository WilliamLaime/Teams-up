<%# ── Email de réponse à un message de contact ──────────────────────────── %>
<%# Envoyé à l'utilisateur quand un admin répond à son message de contact %>
<%# Utilise le layout commun mailer.html.erb (logo + DOCTYPE) %>
<%# Inline CSS obligatoire dans les emails — les clients mail ignorent les feuilles de style externes %>
<div style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; background-color: transparent; padding: 0 20px 40px; min-height: 100vh;">

  <%# Carte centrale %>
  <div style="max-width: 520px; margin: 0 auto; background-color: #1a1c1a; border-radius: 16px; border: 1px solid rgba(255,255,255,0.08); overflow: hidden;">

    <%# Corps du message %>
    <div style="padding: 36px 40px;">

      <%# Icône message %>
      <div style="text-align: center; margin-bottom: 24px;">
        <div style="display: inline-block; background-color: rgba(30, 221, 136, 0.12); border-radius: 50%; width: 64px; height: 64px; line-height: 64px; font-size: 28px;">
          💬
        </div>
      </div>

      <%# Titre %>
      <h1 style="color: #f0f0f0; font-size: 1.4rem; font-weight: 700; text-align: center; margin: 0 0 8px 0;">
        Réponse à ton message
      </h1>

      <%# Sous-titre avec le sujet %>
      <p style="color: rgba(255,255,255,0.45); font-size: 0.9rem; text-align: center; margin: 0 0 28px 0;">
        Sujet : <strong style="color: rgba(255,255,255,0.7);"><%= @contact_message.sujet %></strong>
      </p>

      <%# Salutation %>
      <p style="color: rgba(255,255,255,0.65); font-size: 0.95rem; line-height: 1.6; margin: 0 0 20px 0;">
        Bonjour <strong style="color: #f0f0f0;"><%= @contact_message.prenom %></strong>,
      </p>

      <%# Bloc réponse de l'admin — encart vert %>
      <div style="background-color: rgba(255,255,255,0.04); border-left: 3px solid #1EDD88; border-radius: 4px; padding: 16px 20px; margin-bottom: 24px;">
        <p style="color: rgba(255,255,255,0.4); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px; margin: 0 0 10px 0;">Notre réponse</p>
        <p style="color: #f0f0f0; font-size: 0.95rem; line-height: 1.6; margin: 0; white-space: pre-wrap;"><%= @reply_body %></p>
      </div>

      <%# Message original en citation — bloc plus discret %>
      <div style="background-color: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 16px 20px;">
        <p style="color: rgba(255,255,255,0.35); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px; margin: 0 0 10px 0;">Ton message original</p>
        <p style="color: rgba(255,255,255,0.5); font-size: 0.85rem; line-height: 1.5; margin: 0 0 10px 0; font-style: italic;"><%= @contact_message.message %></p>
        <p style="color: rgba(255,255,255,0.25); font-size: 0.75rem; margin: 0;">
          Envoyé le <%= @contact_message.created_at.strftime("%d/%m/%Y à %Hh%M") %>
        </p>
      </div>

    </div>

    <%# Pied de page %>
    <div style="background-color: #111111; padding: 20px 40px; text-align: center; border-top: 1px solid rgba(255,255,255,0.06);">
      <p style="color: rgba(255,255,255,0.25); font-size: 0.78rem; margin: 0;">
        © <%= Date.today.year %> Teams-up — Ne pas répondre directement à cet email.
      </p>
    </div>

  </div>
</div>
