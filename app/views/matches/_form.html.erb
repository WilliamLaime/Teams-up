<%# ═══════════════════════════════════════════════════════════════
    Formulaire partagé : _form.html.erb
    Utilisé par : new.html.erb (créer) et edit.html.erb (modifier)
    ═══════════════════════════════════════════════════════════════

    Structure HTML :
    ┌──────────────────────────────────────────────────────┐
    │  form (data-controller="match-form")                 │
    │  └── .container                                      │
    │       └── .row                                       │
    │            ├── col-lg-7 : les 4 sections de champs   │
    │            └── col-lg-5 : récapitulatif sticky       │
    └──────────────────────────────────────────────────────┘

    Le contrôleur Stimulus "match-form" (match_form_controller.js)
    lit les valeurs des champs (data-match-form-target="xxxInput")
    et les affiche en temps réel dans le récap (data-match-form-target="recapXxx").
    ═══════════════════════════════════════════════════════════════ %>

<%# Leaflet CSS — chargé uniquement sur les pages avec ce formulaire
    Via content_for :head : inséré dans le <head> du layout application.html.erb
    Le JS Leaflet est chargé via importmap (config/importmap.rb) %>
<% content_for :head do %>
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin="anonymous">
<% end %>

<%# Détermine le chemin du bouton Annuler selon qu'on crée ou modifie un match %>
<% cancel_path = @match.persisted? ? match_path(@match) : matches_path %>

<%# Contexte tournoi : la rencontre est adossée à une confrontation, donc un 1v1
    entre deux joueurs déjà connus que le tournoi inscrit lui-même. Le formulaire
    est allégé (pas de section « Détails du match », récap réduit).

    On teste l'objet et non l'id : à la création c'est
    MatchesController#prefill_from_tournament_match qui l'associe, et au
    ré-affichage après une erreur de validation c'est sanitize_tournament_link
    qui l'a déjà annulé si l'utilisateur n'avait pas le droit de rattacher la
    rencontre. On suit donc toujours la décision du serveur. %>
<% tournament_context = @match.tournament_match.present? %>

<%# form_with génère la balise <form> et la configure automatiquement :
    - @match nouveau     → action="/matches"        method="POST"
    - @match existant    → action="/matches/:id"    method="PATCH"
    data-controller="match-form" → connecte le contrôleur Stimulus %>
<%= form_with model: @match,
    data: {
      controller: "match-form",
      action: "sport-picker:sport-selected->match-form#updateSport"
    } do |f| %>

  <div class="container py-4">

    <%# Affiche les erreurs de validation si le formulaire a été soumis et est invalide %>
    <% if @match.errors.any? %>
      <div class="row mb-3">
        <div class="col-12">
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @match.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    <% end %>

    <%# row sans align-items-start : Bootstrap étire les deux colonnes à la même hauteur
        (celle du formulaire, la plus grande). Ça donne au sticky l'espace pour glisser. %>
    <div class="row g-4">

      <%# ════════════════════════════════════════════════════
          COLONNE GAUCHE : les 4 sections du formulaire
          ════════════════════════════════════════════════════ %>
      <div class="col-lg-7" data-match-form-target="formCol">

        <%# Légende : explication de l'astérisque %>
        <p class="form-required-legend">
          <span class="required-star">*</span> Champs obligatoires
        </p>

        <%# ────────────────────────────────────────────────
            SECTION 1 : Descriptif
            Champs : Titre + Description
            ──────────────────────────────────────────────── %>
        <div class="match-form-section">

          <%# En-tête de la section : badge "1" + titre %>
          <div class="match-form-section-header">
            <div class="match-form-step-badge">1</div>
            <h2 class="match-form-section-title">Descriptif</h2>
          </div>

          <%# ────────────────────────────────────────────────
              Rattachement à un tournoi (Lot 4, élargi Lot 7) — optionnel.
              Visible dès que l'utilisateur organise OU est inscrit à un tournoi non
              terminé (cf. MatchesController#linkable_tournaments_for_select).
              Choisir un tournoi révèle ses confrontations rattachables ; en choisir
              une préremplit le reste du formulaire (sport, titre avec l'adversaire,
              lieu, date) — tout reste modifiable, les deux joueurs conviennent de
              leur créneau. Le lien est aussi posé côté serveur quand on arrive via
              « Créer la rencontre » (?tournament_match_id=X).
              ──────────────────────────────────────────────── %>
          <% if @linkable_tournaments&.any? %>
            <%# Les deux sélecteurs vont de pair (choisir un tournoi révèle ses
                confrontations) : on les met côte à côte sur ≥ md, empilés en
                dessous. `row` gère l'empilement tout seul, aucune media query. %>
            <div class="row g-3 mb-3">
            <div class="col-md-6">
              <%= f.label :tournament_id, class: "form-label" do %>Tournoi <span class="required-star">*</span><% end %>
              <%# Le <select> reste la source de vérité (soumission, data-attributes,
                  évènement `change`) ; custom-select ne fait que l'habiller, le menu
                  natif étant dessiné par l'OS et impossible à mettre au code couleur
                  de l'app. Cf. custom_select_controller.js. %>
              <div class="custom-select" data-controller="custom-select"
                   data-action="keydown->custom-select#keydown">
                <%= f.collection_select :tournament_id, @linkable_tournaments, :id, :name,
                      { include_blank: "Aucun (match indépendant)" },
                      class: "form-select custom-select__native",
                      data: {
                        "custom-select-target": "native",
                        "match-form-target": "tournamentInput",
                        "action": "change->match-form#updateTournament",
                        "tournament-matches": (@linkable_tournament_matches || {}).to_json,
                        "new-match-path": new_match_path
                      } %>
              </div>
            </div>

            <%# Confrontation du tournoi. Les options du tournoi COURANT sont rendues
                côté serveur (état initial, y compris à l'arrivée via « Créer la
                rencontre ») ; le JS les remplace quand on change de tournoi. %>
            <% current_confrontations = (@linkable_tournament_matches || {})[@match.tournament_id] || [] %>
            <%# Stimulus bascule `style.display` entre "none" et "" sur ce wrapper :
                une colonne Bootstrap est un simple bloc, la valeur vide restaure
                donc bien la mise en page. %>
            <div class="col-md-6" data-match-form-target="tournamentMatchWrapper"
                 style="<%= 'display:none;' if current_confrontations.empty? %>">
              <%= f.label :tournament_match_id, class: "form-label" do %>Confrontation <span class="required-star">*</span><% end %>
              <div class="custom-select" data-controller="custom-select"
                   data-action="keydown->custom-select#keydown">
                <%= f.select :tournament_match_id,
                      options_for_select(current_confrontations.map { |c| [c[:label], c[:id]] }, @match.tournament_match_id),
                      { include_blank: "Aucune (rencontre libre)" },
                      class: "form-select custom-select__native",
                      data: {
                        "custom-select-target": "native",
                        "match-form-target": "tournamentMatchInput",
                        "action": "change->match-form#applyTournamentMatch"
                      } %>
              </div>
            </div>
            </div><%# fin row tournoi + confrontation %>
          <% end %>

          <%# Champ Sport — visible et pré-rempli avec le sport actif
              L'utilisateur peut le modifier si besoin %>
          <div class="mb-3">
            <%= f.label :sport_id, class: "form-label" do %>Sport <span class="required-star">*</span><% end %>
            <%
              # Maps JSON passées au controller Stimulus pour adapter le compteur au sport/format
              sports_defaults = Sport.order(:name).each_with_object({}) { |s, h| h[s.id] = s.default_player_count }
              sports_max      = Sport.order(:name).each_with_object({}) { |s, h| h[s.id] = s.max_player_count }
              # Pour le récap Stimulus : emoji + nom (image sports → juste le nom)
              sports_names    = Sport.order(:name).each_with_object({}) { |s, h| h[s.id] = "#{sport_icon_text(s)} #{s.name}".strip }
              # Formats disponibles par sport : { sportId => [{label, players}, ...] }
              sports_formats  = Sport.order(:name).each_with_object({}) { |s, h| h[s.id] = s.available_formats }
              # Niveaux disponibles par sport : { sportId => [{label, ref?}, ...] }
              sports_levels   = Sport.order(:name).each_with_object({}) { |s, h| h[s.id] = s.available_levels }

              # Images disponibles par sport — URLs Cloudinary via SportImagesHelper
              # Construit { sportId => [url1, url2, ...] }
              sports_images_map = Sport.order(:name).each_with_object({}) do |s, h|
                h[s.id] = sport_images_for(s.slug)
              end
            %>
            <%#
              Select caché — soumis avec le formulaire et cible Stimulus.
              Le dropdown custom ci-dessous met à jour sa valeur et déclenche
              un event "change" pour que Stimulus (updateSport) réagisse.
            %>
            <%= f.hidden_field :sport_id,
                data: {
                  "match-form-target": "sportInput",
                  "defaults": sports_defaults.to_json,
                  "max-players": sports_max.to_json,
                  "sport-names": sports_names.to_json,
                  "formats": sports_formats.to_json,
                  # niveaux : { sportId => [{label, ref?}, ...] } — utilisé par Stimulus pour
                  # générer les boutons de niveau dynamiquement selon le sport sélectionné
                  "levels": sports_levels.to_json,
                  # images : { sportId => [url1, url2, ...] } — utilisé par Stimulus pour
                  # changer l'image de la banner dynamiquement selon le sport sélectionné
                  "images": sports_images_map.to_json
                } %>

            <%# Champ caché banner_image : stocke l'URL de l'image choisie (soumise avec le formulaire)
                Stimulus met sa valeur à jour via updateBanner() quand le sport change %>
            <%= f.hidden_field :banner_image,
                data: { "match-form-target": "bannerImageInput" } %>

            <%# Dropdown custom — affiche les icônes image + emoji %>
            <div style="position:relative;" data-controller="sport-picker">

              <%# Trigger : affiche le sport sélectionné (ou le prompt)
                  form-select = même style + chevron blanc que date/heure
                  Le contenu intérieur est en flex via un <span> pour ne pas casser
                  le background-image du chevron Bootstrap %>
              <button type="button"
                      class="form-select"
                      data-sport-picker-target="trigger"
                      data-action="click->sport-picker#toggle"
                      style="cursor:pointer; text-align:left;">
                <span class="d-flex align-items-center gap-2">
                  <% if @match.sport %>
                    <%= sport_icon(@match.sport, size: "1.1rem") %>
                    <span><%= @match.sport.name %></span>
                  <% else %>
                    <%# Classe CSS sport-picker-placeholder — adapte la couleur au thème %>
                    <span class="sport-picker-placeholder">Sélectionner un sport</span>
                  <% end %>
                </span>
              </button>

              <%# Panel dropdown avec tous les sports
                  Les styles sont dans _sport.scss (.sport-picker-dropdown)
                  pour qu'ils s'adaptent au thème clair/sombre via CSS variables.
                  "display:none" reste en inline car Stimulus le gère dynamiquement. %>
              <div data-sport-picker-target="dropdown"
                   class="sport-picker-dropdown"
                   style="display:none;">
                <% Sport.order(:name).each do |sport| %>
                  <%# data-active="true" = sport actuellement sélectionné → fond vert géré par le controller %>
                  <button type="button"
                          class="sport-picker-item w-100 d-flex align-items-center gap-2 text-start <%= 'sport-picker-item--active' if @match.sport_id == sport.id %>"
                          data-action="click->sport-picker#select"
                          data-sport-picker-target="item"
                          data-sport-id="<%= sport.id %>"
                          data-sport-name="<%= sport.name %>">
                    <%= sport_icon(sport, size: "1.1rem") %>
                    <span><%= sport.name %></span>
                  </button>
                <% end %>
              </div>
            </div>

          </div>

          <%# Champ Titre — obligatoire
              data-match-form-target="titleInput" : Stimulus surveille ce champ
              data-action="input->match-form#updateTitle" : met à jour le récap à chaque frappe %>
          <div class="mb-3">
            <%= f.label :title, class: "form-label" do %>Titre <span class="required-star">*</span><% end %>
            <%= f.text_field :title,
                class: "form-control",
                placeholder: "Ex: Match foot samedi matin",
                required: true,
                data: {
                  "match-form-target": "titleInput",
                  "action": "input->match-form#updateTitle"
                } %>
          </div>

          <%# Champ Description — facultatif
              Textarea redimensionnable (4 lignes par défaut) %>
          <div class="mb-0">
            <%= f.label :description, "Description", class: "form-label" %>
            <%= f.text_area :description,
                class: "form-control",
                rows: 4,
                placeholder: "Décris le match, le niveau attendu, les règles...",
                data: {
                  "match-form-target": "descriptionInput",
                  "action": "input->match-form#updateDescription"
                } %>
          </div>

        </div><%# fin section 1 %>


        <%# ────────────────────────────────────────────────
            SECTION 2 : Lieu
            Champ : Lieu avec autocomplétion (Stimulus "place-search")
            ──────────────────────────────────────────────── %>
        <%# IMPORTANT : ce div a DEUX contrôleurs Stimulus :
            - "place-search"  → gère l'autocomplétion (suggestions Nominatim)
            - "match-form"    → est sur le <form>, donc englobe tout
            Le target "placeInput" est reconnu par les deux %>
        <div class="match-form-section" data-controller="place-search">

          <div class="match-form-section-header">
            <div class="match-form-step-badge">2</div>
            <h2 class="match-form-section-title">Où se déroule le match ?</h2>
          </div>

          <div class="mb-0">
            <%= f.label :place, class: "form-label" do %>Rechercher un club ou une adresse <span class="required-star">*</span><% end %>

            <%# data-place-search-target="inputWrapper" : utilisé par handleOutsideClick pour
                détecter les clics EN DEHORS du champ+dropdown uniquement.
                Sans ça, this.element (= toute la section 2) rendrait le dropdown inféreable
                uniquement en cliquant hors de la section entière. %>
            <div class="position-relative" data-place-search-target="inputWrapper">
              <%# Le champ texte :
                  - data-place-search-target="input"   → autocomplétion
                  - data-match-form-target="placeInput" → récap Stimulus
                  - focus->place-search#showDefault     → ouvre le dropdown avec "Ma position" au clic
                  - data-action avec les actions séparées par un espace %>
              <%# form-select = même chevron blanc que date/heure/sport %>
              <%= f.text_field :place,
                  class: "form-select",
                  placeholder: "Ex: Urban Soccer, Bordeaux...",
                  autocomplete: "off",
                  required: true,
                  data: {
                    "place-search-target": "input",
                    "match-form-target":   "placeInput",
                    "action": "input->place-search#search focus->place-search#showDefault input->match-form#updatePlace"
                  } %>

              <%# Champ caché : stocke l'id du venue sélectionné en BDD
                  Rempli par place_search_controller.js quand l'user choisit un résultat BDD.
                  Vide si l'user choisit un résultat OSM ou saisit librement. %>
              <%= f.hidden_field :venue_id, data: { "place-search-target": "venueId" } %>

              <%# Dropdown des suggestions — géré par place_search_controller.js %>
              <div data-place-search-target="dropdown"
                   class="dropdown-menu w-100 shadow"
                   style="display:none; position:absolute; top:100%; left:0; z-index:1050; max-height:250px; overflow-y:auto;">
              </div>
            </div>

            <%# Bouton secondaire : ouvre la modale de sélection sur carte
                Utile si aucun résultat ne correspond (terrain privé, coin de rue, etc.) %>
            <button type="button"
                    class="map-picker-trigger-btn mt-2"
                    data-bs-toggle="modal"
                    data-bs-target="#mapPickerModal">
              <i data-lucide="map-pin" style="width:14px; height:14px;"></i>
              Choisir sur la carte
            </button>

          </div>

        </div><%# fin section 2 %>


        <%# ════════════════════════════════════════════════════
            MODALE : Sélecteur de lieu sur carte
            Contrôleur Stimulus : map-picker
            ════════════════════════════════════════════════════
            data-controller="map-picker" est sur la modale elle-même.
            Stimulus l'initialise dès que la modale entre dans le DOM.
            La carte Leaflet est créée au premier "shown.bs.modal". %>
        <div class="modal fade"
             id="mapPickerModal"
             tabindex="-1"
             aria-labelledby="mapPickerModalLabel"
             aria-hidden="true"
             data-controller="map-picker">

          <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content map-picker-modal-content">

              <%# En-tête de la modale %>
              <div class="modal-header map-picker-modal-header">
                <h5 class="modal-title" id="mapPickerModalLabel">
                  <i data-lucide="map-pin" style="width:16px; height:16px; color:#1EDD88; margin-right:6px;"></i>
                  Choisir un lieu sur la carte
                </h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Fermer"></button>
              </div>

              <%# Corps de la modale %>
              <div class="modal-body p-0">

                <%# Barre de recherche d'adresse — permet de centrer la carte sur un lieu
                    sans avoir à naviguer manuellement.
                    keydown.enter → déclenche searchAddress dès que l'user appuie sur Entrée %>
                <div class="map-picker-search-bar">
                  <i data-lucide="search" style="width:18px; height:18px; flex-shrink:0;"></i>
                  <input type="text"
                         data-map-picker-target="searchInput"
                         class="map-picker-search-input"
                         placeholder="Rechercher une adresse pour centrer la carte…"
                         autocomplete="off"
                         data-action="keydown.enter->map-picker#searchAddress">
                  <button type="button"
                          class="map-picker-search-btn"
                          data-action="click->map-picker#searchAddress">
                    Centrer
                  </button>
                </div>

                <%# Instruction affichée au-dessus de la carte %>
                <p class="map-picker-instruction">
                  Clique sur l'endroit exact où se déroule le match.
                </p>

                <%# Conteneur de la carte Leaflet
                    La hauteur est fixe (CSS) pour que Leaflet ait une taille calculée.
                    data-map-picker-target="mapContainer" → Stimulus monte la carte ici %>
                <div id="map-picker-container"
                     data-map-picker-target="mapContainer"
                     class="map-picker-container">
                </div>

              </div>

              <%# Pied de la modale : affichage de l'adresse + bouton Confirmer %>
              <div class="modal-footer map-picker-modal-footer">

                <%# Zone d'affichage de l'adresse reverse-géocodée
                    Remplie par Stimulus après le clic sur la carte %>
                <div class="map-picker-address-wrap">
                  <i data-lucide="map-pin" style="width:14px; height:14px; color:#1EDD88; flex-shrink:0;"></i>
                  <span data-map-picker-target="addressDisplay"
                        class="map-picker-address-text">
                    Clique sur la carte pour choisir un lieu
                  </span>
                </div>

                <%# Bouton Confirmer — désactivé jusqu'à ce qu'un lieu soit choisi %>
                <button type="button"
                        class="map-picker-confirm-btn"
                        data-map-picker-target="confirmBtn"
                        data-action="click->map-picker#confirmLocation"
                        disabled>
                  Confirmer ce lieu
                </button>

              </div>

            </div>
          </div>
        </div><%# fin modale map-picker %>


        <%# ────────────────────────────────────────────────
            SECTION 3 : Quand ?
            Champs : Date + Heure (deux colonnes)
            ──────────────────────────────────────────────── %>
        <div class="match-form-section">

          <div class="match-form-section-header">
            <div class="match-form-step-badge">3</div>
            <h2 class="match-form-section-title">Quand ?</h2>
          </div>

          <div class="row g-3">

            <%# Champ Date — dropdown calendrier custom (date_picker_controller)
                Pleine largeur (col-12) : les deux heures (début/fin) occupent la ligne suivante %>
            <div class="col-12">
              <%= f.label :date, class: "form-label" do %>Date du match <span class="required-star">*</span><% end %>

              <%# Conteneur du picker : même pattern que time-picker %>
              <div style="position:relative;" data-controller="date-picker">

                <%# Input caché : valeur réelle soumise avec le formulaire
                    data-match-form-target → récap | data-action → updateDate au changement %>
                <%= f.hidden_field :date,
                    value: @match.date,
                    data: {
                      "date-picker-target": "input",
                      "match-form-target":  "dateInput",
                      "action":             "change->match-form#updateDate"
                    } %>

                <%# Trigger : bouton avec icône calendrier à droite au lieu du chevron %>
                <button type="button"
                        class="form-select w-100 dp-trigger"
                        data-date-picker-target="trigger"
                        data-action="click->date-picker#toggle"
                        style="cursor:pointer; display:flex; align-items:center; background-image:none; padding-right:0.75rem;">
                  <%# Span du texte — mis à jour par Stimulus sans toucher à l'icône
                      Utilise une classe CSS pour la couleur afin de s'adapter au thème %>
                  <span data-date-picker-target="triggerText"
                        class="<%= @match.date.present? ? '' : 'sport-picker-placeholder' %>">
                    <% if @match.date.present? %>
                      <% fr_days = %w[Dim Lun Mar Mer Jeu Ven Sam]; fr_months = %w[jan. fév. mars avr. mai juin juil. août sept. oct. nov. déc.] %>
                      <%= "#{fr_days[@match.date.wday]} #{@match.date.day} #{fr_months[@match.date.month - 1]} #{@match.date.year}" %>
                    <% else %>
                      Choisir une date
                    <% end %>
                  </span>
                  <%# Icône calendrier — reste fixe, jamais remplacée par Stimulus %>
                  <i data-lucide="calendar" style="width:14px;height:14px;color:var(--theme-text-muted);flex-shrink:0;margin-left:auto;"></i>
                </button>

                <%# Dropdown calendrier — rempli dynamiquement par le controller JS %>
                <div data-date-picker-target="dropdown"
                     class="dp-dropdown"
                     style="display:none; position:absolute; top:calc(100% + 4px); left:0; z-index:400; min-width:280px;">
                </div>

              </div>
            </div>

            <%# Champ Heure
                Deux selects custom (au lieu de time_select) pour limiter les options :
                  - Heures : 6h à 23h uniquement (pas de 0h-5h)
                  - Minutes : 00, 15, 30, 45
                Les noms time(4i) / time(5i) sont la convention Rails pour les champs composés %>
            <div class="col-md-6">
              <%= f.label :time, class: "form-label" do %>Heure de début <span class="required-star">*</span><% end %>
              <div class="d-flex gap-2"
                   data-action="change->match-form#startTimeChanged">

                <%# ── Dropdown custom pour les heures (time_picker_controller) ── %>
                <%# Affiche 5 heures à la fois + scroll — même pattern que sport-picker %>
                <div style="position:relative; flex:1;" data-controller="time-picker">

                  <%# Input hidden time(4i) : valeur réelle soumise avec le formulaire %>
                  <%= f.hidden_field "time(4i)",
                      value: @match.time&.hour,
                      data: { "time-picker-target": "input" } %>

                  <%# Trigger : même rendu visuel que le form-select des minutes
                      Classe sport-picker-placeholder si aucune heure choisie → couleur via CSS %>
                  <button type="button"
                          class="form-select w-100 <%= 'sport-picker-placeholder' unless @match.time %>"
                          data-time-picker-target="trigger"
                          data-action="click->time-picker#toggle"
                          style="cursor:pointer; text-align:left;">
                    <%= @match.time ? ("%02dh" % @match.time.hour) : "Heure" %>
                  </button>

                  <%# Dropdown heures — visuels (fond, bordure, border-radius, shadow) dans .time-picker-dropdown CSS
                      On garde uniquement les styles de position/layout en inline %>
                  <div class="time-picker-dropdown"
                       data-time-picker-target="dropdown"
                       style="display:none; position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:400; overflow-y:auto; max-height:200px;">
                    <% (0..23).each do |h| %>
                      <%# On ne met en inline que le background (valeur dynamique selon l'état actif)
                          La couleur du texte est gérée par .time-picker-item { color: var(--theme-text-muted) } %>
                      <button type="button"
                              class="time-picker-item w-100 <%= 'time-picker-item--active' if @match.time&.hour == h %>"
                              style="background:<%= @match.time&.hour == h ? 'rgba(30,221,136,0.12)' : 'transparent' %> !important;"
                              data-time-picker-item
                              data-action="click->time-picker#select"
                              data-value="<%= h %>"
                              data-label="<%= "%02dh" % h %>">
                        <%= "%02dh" % h %>
                      </button>
                    <% end %>
                  </div>

                </div>

                <%# ── Dropdown custom pour les minutes — même pattern que les heures ── %>
                <div style="position:relative; flex:1;" data-controller="time-picker">

                  <%# Input hidden time(5i) : valeur réelle soumise avec le formulaire %>
                  <%= f.hidden_field "time(5i)",
                      value: @match.time&.min,
                      data: { "time-picker-target": "input" } %>

                  <%# Trigger : même rendu que le bouton heures
                      Classe sport-picker-placeholder si aucune minute choisie %>
                  <button type="button"
                          class="form-select w-100 <%= 'sport-picker-placeholder' unless @match.time %>"
                          data-time-picker-target="trigger"
                          data-action="click->time-picker#toggle"
                          style="cursor:pointer; text-align:left;">
                    <%= @match.time ? ("%02d" % @match.time.min) : "Min" %>
                  </button>

                  <%# Dropdown minutes — visuels dans .time-picker-dropdown CSS, position en inline %>
                  <div class="time-picker-dropdown"
                       data-time-picker-target="dropdown"
                       style="display:none; position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:400; overflow-y:auto; max-height:200px;">
                    <% [[0, "00"], [15, "15"], [30, "30"], [45, "45"]].each do |val, lbl| %>
                      <%# Background dynamique en inline, couleur texte via CSS %>
                      <button type="button"
                              class="time-picker-item w-100 <%= 'time-picker-item--active' if @match.time&.min == val %>"
                              style="background:<%= @match.time&.min == val ? 'rgba(30,221,136,0.12)' : 'transparent' %> !important;"
                              data-time-picker-item
                              data-action="click->time-picker#select"
                              data-value="<%= val %>"
                              data-label="<%= lbl %>">
                        <%= lbl %>
                      </button>
                    <% end %>
                  </div>

                </div>

              </div>
            </div>

            <%# Champ Heure de fin
                Même structure que « Heure de début » (deux selects custom heures/minutes).
                Valeur par défaut = début + 1h (posée côté serveur au new, puis synchronisée
                en JS tant que l'utilisateur n'a pas modifié la fin manuellement). %>
            <div class="col-md-6">
              <%= f.label :end_time, "Heure de fin", class: "form-label" %>
              <div class="d-flex gap-2"
                   data-action="change->match-form#endTimeChanged">

                <%# ── Dropdown custom pour les heures de fin ── %>
                <div style="position:relative; flex:1;" data-controller="time-picker">

                  <%# Input hidden end_time(4i) : heures de fin %>
                  <%= f.hidden_field "end_time(4i)",
                      value: @match.end_time&.hour,
                      data: { "time-picker-target": "input" } %>

                  <button type="button"
                          class="form-select w-100 <%= 'sport-picker-placeholder' unless @match.end_time %>"
                          data-time-picker-target="trigger"
                          data-action="click->time-picker#toggle"
                          style="cursor:pointer; text-align:left;">
                    <%= @match.end_time ? ("%02dh" % @match.end_time.hour) : "Heure" %>
                  </button>

                  <div class="time-picker-dropdown"
                       data-time-picker-target="dropdown"
                       style="display:none; position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:400; overflow-y:auto; max-height:200px;">
                    <% (0..23).each do |h| %>
                      <button type="button"
                              class="time-picker-item w-100 <%= 'time-picker-item--active' if @match.end_time&.hour == h %>"
                              style="background:<%= @match.end_time&.hour == h ? 'rgba(30,221,136,0.12)' : 'transparent' %> !important;"
                              data-time-picker-item
                              data-action="click->time-picker#select"
                              data-value="<%= h %>"
                              data-label="<%= "%02dh" % h %>">
                        <%= "%02dh" % h %>
                      </button>
                    <% end %>
                  </div>

                </div>

                <%# ── Dropdown custom pour les minutes de fin ── %>
                <div style="position:relative; flex:1;" data-controller="time-picker">

                  <%# Input hidden end_time(5i) : minutes de fin %>
                  <%= f.hidden_field "end_time(5i)",
                      value: @match.end_time&.min,
                      data: { "time-picker-target": "input" } %>

                  <button type="button"
                          class="form-select w-100 <%= 'sport-picker-placeholder' unless @match.end_time %>"
                          data-time-picker-target="trigger"
                          data-action="click->time-picker#toggle"
                          style="cursor:pointer; text-align:left;">
                    <%= @match.end_time ? ("%02d" % @match.end_time.min) : "Min" %>
                  </button>

                  <div class="time-picker-dropdown"
                       data-time-picker-target="dropdown"
                       style="display:none; position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:400; overflow-y:auto; max-height:200px;">
                    <% [[0, "00"], [15, "15"], [30, "30"], [45, "45"]].each do |val, lbl| %>
                      <button type="button"
                              class="time-picker-item w-100 <%= 'time-picker-item--active' if @match.end_time&.min == val %>"
                              style="background:<%= @match.end_time&.min == val ? 'rgba(30,221,136,0.12)' : 'transparent' %> !important;"
                              data-time-picker-item
                              data-action="click->time-picker#select"
                              data-value="<%= val %>"
                              data-label="<%= lbl %>">
                        <%= lbl %>
                      </button>
                    <% end %>
                  </div>

                </div>

              </div>
            </div>

          </div>
        </div><%# fin section 3 %>


        <%# ────────────────────────────────────────────────
            SECTION 4 : Détails du match
            Format, nombre de joueurs, niveau, validation, visibilité,
            équipe, genre, prix, lien de réservation.

            Masquée en contexte tournoi : une confrontation est un 1v1
            entre deux joueurs qui se connaissent et que le tournoi
            inscrit lui-même — il n'y a ni place à pourvoir, ni niveau
            à filtrer. Les valeurs qu'exige le modèle sont alors
            envoyées en champs cachés.
            ──────────────────────────────────────────────── %>
        <% if tournament_context %>
          <%= render "matches/tournament_hidden_fields", f: f %>
        <% else %>
          <%= render "matches/details_section", f: f %>
        <% end %>

        <%# Lien Annuler visible uniquement sur mobile (< lg)
            Sur desktop il est dans la sidebar %>
        <div class="d-lg-none mt-2">
          <%= link_to "Annuler", cancel_path, class: "btn btn-outline-secondary w-100" %>
        </div>

      </div><%# fin colonne gauche %>


      <%# ════════════════════════════════════════════════════
          COLONNE DROITE : Récapitulatif (sticky)
          Cette colonne reste visible pendant le scroll grâce à
          position: sticky dans _match_form.scss
          ════════════════════════════════════════════════════ %>
      <%# position:sticky + align-self:flex-start : la colonne a sa hauteur naturelle
          (celle de la carte) et reste visible en haut pendant le scroll.
          top:-1.5rem (négatif) : compense le margin-top:2rem de .match-recap-card
          → au scroll, la carte apparaît à -1.5rem + 2rem = 0.5rem du haut de l'écran %>
      <div class="col-lg-5" style="position:sticky; top:-16px; align-self:flex-start;">
        <div class="match-recap-card">

          <%# En-tête "Récapitulatif" avec icône %>
          <div class="match-recap-header">
            <i data-lucide="bar-chart-2" style="width:18px; height:18px;"></i>
            <span>Récapitulatif</span>
          </div>

          <%# Titre du match (mis à jour en temps réel par Stimulus)
              Valeur initiale : titre existant ou texte par défaut %>
          <h3 class="match-recap-main-title"
              data-match-form-target="recapTitle">
            <%# Première lettre en majuscule, reste en minuscules %>
            <%= @match.title.present? ? (@match.title[0].upcase + @match.title[1..].downcase) : "Titre" %>
          </h3>

          <%# Description courte (tronquée à 80 caractères par Stimulus)
              Masquée si vide — Stimulus la réaffiche quand l'utilisateur saisit quelque chose %>
          <p class="match-recap-description"
             data-match-form-target="recapDescription"
             style="<%= 'display:none;' if @match.description.blank? %>">
            <%= truncate(@match.description.to_s, length: 80) %>
          </p>

          <%# ── Ligne Sport ── %>
          <div class="match-recap-row">
            <span class="recap-label">Sport</span>
            <span class="recap-value" data-match-form-target="recapSport">
              <%# Affiche l'emoji + nom du sport si sélectionné %>
              <% if @match.sport %>
                <%= sport_icon(@match.sport, size: "1rem") %> <%= @match.sport.name %>
              <% else %>
                —
              <% end %>
            </span>
          </div>

          <%# ── Ligne Tournoi (contexte tournoi uniquement) ──
              Rappelle à quel tournoi la rencontre est rattachée, à la place des
              lignes de la section « Détails du match » qui sont masquées. %>
          <% if tournament_context %>
            <div class="match-recap-row">
              <span class="recap-label">Tournoi</span>
              <span class="recap-value"><%= @match.tournament&.name %></span>
            </div>
          <% end %>

          <%# ── Ligne Lieu ── %>
          <div class="match-recap-row">
            <span class="recap-label">Lieu</span>
            <span class="recap-value" data-match-form-target="recapPlace">
              <%= @match.place.to_s %>
            </span>
          </div>

          <%# ── Ligne Date ── %>
          <div class="match-recap-row">
            <span class="recap-label">Date</span>
            <span class="recap-value" data-match-form-target="recapDate">
              <%# strftime formatage : "16 mar. 2026"
                  Stimulus mettra à jour avec le format français dynamiquement %>
              <%= @match.date.present? ? @match.date.strftime("%d %b %Y") : "—" %>
            </span>
          </div>

          <%# ── Ligne Heure de début ── %>
          <div class="match-recap-row">
            <span class="recap-label">Début</span>
            <span class="recap-value" data-match-form-target="recapTime">
              <%# strftime "%Hh%M" donne "21h15" %>
              <%= @match.time.present? ? @match.time.strftime("%Hh%M") : "—" %>
            </span>
          </div>

          <%# ── Ligne Heure de fin ──
              En contexte tournoi elle devient la dernière ligne du récap (tout
              ce qui suit est masqué) : on lui retire alors son trait de séparation. %>
          <div class="match-recap-row" style="<%= 'border-bottom: none;' if tournament_context %>">
            <span class="recap-label">Fin</span>
            <span class="recap-value" data-match-form-target="recapEndTime">
              <%= @match.end_time.present? ? @match.end_time.strftime("%Hh%M") : "—" %>
            </span>
          </div>

          <%# ── Lignes propres à la section « Détails du match » ──
              Masquées en contexte tournoi, où cette section n'est pas rendue :
              afficher « Joueurs recherchés » ou « Niveau souhaité » pour une
              confrontation 1v1 déjà pourvue induirait en erreur. %>
          <% unless tournament_context %>

          <%# ── Ligne Format — masquée si sport mono-format ── %>
          <div class="match-recap-row" data-match-form-target="recapFormatRow" style="display:none;">
            <span class="recap-label">Format</span>
            <span class="recap-value" data-match-form-target="recapFormat">—</span>
          </div>

          <%# ── Ligne Présents (visible uniquement en mode Libre) ── %>
          <div class="match-recap-row"
               data-match-form-target="recapPresentRow"
               style="<%= @match.libre? ? '' : 'display:none;' %>">
            <span class="recap-label">Présents</span>
            <span class="recap-value" data-match-form-target="recapPresent">
              <%= @match.players_present || 1 %>
            </span>
          </div>

          <%# ── Ligne Joueurs recherchés ── %>
          <div class="match-recap-row">
            <span class="recap-label">Joueurs recherchés</span>
            <span class="recap-value" data-match-form-target="recapPlayers">
              <%= @match.players_needed || 4 %>
            </span>
          </div>

          <%# ── Ligne Niveau souhaité ── %>
          <div class="match-recap-row">
            <span class="recap-label">Niveau souhaité</span>
            <span class="recap-value" data-match-form-target="recapLevel">
              <%= @match.level.to_s %>
            </span>
          </div>

          <%# ── Ligne Validation — mise à jour en temps réel par Stimulus ── %>
          <div class="match-recap-row" style="border-bottom: none;">
            <span class="recap-label">Validation</span>
            <%# data-match-form-target="recapValidation" : Stimulus écrit "Manuel" ou "Automatique" ici %>
            <span class="recap-value" data-match-form-target="recapValidation">
              <%= @match.manual_validation? ? "Manuel" : "Automatique" %>
            </span>
          </div>

          <%# ── Prix par joueur (affiché en blanc en bas du récap) ── %>
          <div class="match-recap-price mt-1">
            <span class="recap-price-label">Prix par joueur</span>
            <span class="recap-price-value" data-match-form-target="recapPrice">
              <%# Affiche le prix en € si > 0, sinon rien %>
              <% price = @match.price_per_player.to_i %>
              <%= price > 0 ? "#{price} €" : "" %>
            </span>
          </div>

          <% end %><%# fin des lignes masquées en contexte tournoi %>

          <%# ── Partage Slack (création uniquement) ── %>
          <% if @match.new_record? %>
            <%= render "shared/slack_share_frame" %>
          <% end %>

          <%# ── Bouton de soumission ──
              f.submit détecte automatiquement si c'est une création ou une modification
              On surcharge le texte manuellement pour coller au design %>
          <%= f.submit(@match.new_record? ? "Publier le match" : "Enregistrer les modifications",
              class: "match-publish-btn") %>

          <%# Petit texte légal sous le bouton %>
          <p class="match-publish-legal">
            En publiant, vous acceptez nos conditions d'utilisation et la politique d'annulation.
          </p>

          <%# Lien Annuler visible uniquement sur desktop (≥ lg)
              Sur mobile il est en bas de la colonne gauche %>
          <div class="d-none d-lg-block text-center mt-2">
            <%= link_to "Annuler", cancel_path,
                class: "btn btn-link btn-sm text-success" %>
          </div>

        </div><%# fin match-recap-card %>
      </div><%# fin colonne droite %>

    </div><%# fin row %>
  </div><%# fin container %>

<% end %><%# fin form_with %>
