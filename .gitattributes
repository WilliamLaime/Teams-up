# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# Mark the database schema as having been generated.
db/schema.rb linguist-generated

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored
config/credentials/*.yml.enc diff=rails_credentials
config/credentials.yml.enc diff=rails_credentials

# Graphe de code graphify (versionné, cf. .gitignore).
# merge=graphify : deux branches qui touchent au code produisent chacune leur
#   graphe, donc un conflit à chaque merge. Le pilote fusionne les deux graphes
#   au lieu de demander un arbitrage manuel sur 3 Mo de JSON. Il est déclaré par
#   `bin/setup` ; sans lui git retombe sur la fusion texte classique, et le
#   remède est alors `git checkout --ours graphify-out/graph.json && graphify update .`
# -diff : ce sont des artefacts générés, un diff de 3 Mo n'est lisible par
#   personne et noie la revue.
graphify-out/graph.json merge=graphify -diff linguist-generated
graphify-out/graph.html -diff linguist-generated
graphify-out/GRAPH_REPORT.md -diff linguist-generated
