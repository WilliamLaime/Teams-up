# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore database dumps.
*.dump

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# Ignore .env file containing credentials.
.env

# Ignore Claude Code local machine settings.
/.claude/settings.local.json

# Ignore Mac and Linux file system files
*.swp
.DS_Store
app/assets/images/sports/

# Fichiers de travail temporaires (documents générés, non versionnés)
calendrier_editorial_teamup.html
plan_communaute_teamup.html
posts_instagram_teamup.html
scripts_tiktok_teamup.html
stories_instagram_teamup.html
reels_instagram_teamup.html
retroplanning_teamup.html
retroplanning_teamup.xlsx
generate_excel.js
node_modules/
package.json
package-lock.json

# Réglages Claude Code personnels (machine-spécifiques, non partagés).
# settings.json (sans .local) reste versionnable pour d'éventuels réglages d'équipe.
.claude/settings.local.json

# Graphe de connaissance graphify.
# Le graphe est VERSIONNÉ pour que toute l'équipe en dispose sans rien installer
# ni reconstruire. Malgré leur taille brute (~6 Mo), ces fichiers se compressent
# à ~370 Ko dans git, et le pilote de fusion (.gitattributes) absorbe les
# conflits. Ils sont maintenus par le hook .githooks/pre-commit.
# ⚠️ `!graphify-out/` d'abord, et il n'est pas décoratif : git refuse de
# ré-inclure un fichier si un RÉPERTOIRE parent est exclu — il n'y descend même
# pas. Or le .gitignore_global de certains postes (dont celui d'origine) exclut
# `graphify-out/`. Cette ligne annule cette exclusion pour ce dépôt, sans quoi
# les trois négations ci-dessous n'ont aucun effet.
!graphify-out/
graphify-out/*
!graphify-out/graph.json
!graphify-out/graph.html
!graphify-out/GRAPH_REPORT.md

# En revanche, tout ce qui est propre à un poste reste local : le cache
# d'extraction AST (plusieurs Mo, reconstruit en 6 s), le manifeste, le chemin
# de l'interpréteur Python de la machine et les sauvegardes datées.
graphify-out/cache/
graphify-out/manifest.json
graphify-out/.graphify_*
graphify-out/20*/
